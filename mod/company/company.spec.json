  "CCFoundAsk": {
   "type": "DIAL",
   "fields": [
    {
     "tag": "FULL",
     "text": "You lend money to traders?"
    },
    {
     "tag": "DATA",
     "hex": "0002"
    }
   ],
   "infos": [
    {
     "key": "pitch_tagg",
     "quest": "@CCFounding",
     "conditions": [
      {
       "function": "GetIsID",
       "param1": "@CCAgentHollis",
       "op": "==",
       "value": 1
      },
      {
       "function": "GetQuestVariable",
       "param1": "@CCCore",
       "param2": 2,
       "op": "==",
       "value": 0
      },
      {
       "function": "GetQuestVariable",
       "param1": "@CCFounding",
       "param2": 2,
       "op": "==",
       "value": 1
      }
     ],
     "choices": [
      "@CCFoundTerms",
      "@CCFoundSign",
      "@CCFoundNo"
     ],
     "responses": [
      "Miss McLafferty is gone, but the Crimson Caravan Company still lends. Jason Tagg runs her desk now, and I write his paper.",
      "Three thousand caps at four percent a week on what is left, three hundred of the principal every week. You put in five hundred of your own.",
      "That buys a wagon, two brahmin, a driver, a guard and a trade licence. The rest is yours to trade with. Interested?"
     ]
    },
    {
     "key": "pitch_gang",
     "quest": "@CCFounding",
     "conditions": [
      {
       "function": "GetIsID",
       "param1": "@CCAgentHollis",
       "op": "==",
       "value": 1
      },
      {
       "function": "GetQuestVariable",
       "param1": "@CCCore",
       "param2": 2,
       "op": "==",
       "value": 0
      },
      {
       "function": "GetQuestVariable",
       "param1": "@CCFounding",
       "param2": 3,
       "op": "==",
       "value": 1
      }
     ],
     "choices": [
      "@CCFoundTerms",
      "@CCFoundSign",
      "@CCFoundNo"
     ],
     "responses": [
      "Miss McLafferty lends to people who move goods. Three thousand caps at four percent a week, three hundred of the principal weekly.",
      "The Powder Gangers run Goodsprings now. They will want their cut, but they leave paying wagons alone. You put in five hundred of your own.",
      "That buys a wagon, two brahmin, a driver, a guard and a trade licence. The rest is yours to trade with. Interested?"
     ]
    },
    {
     "key": "pitch",
     "quest": "@CCFounding",
     "conditions": [
      {
       "function": "GetIsID",
       "param1": "@CCAgentHollis",
       "op": "==",
       "value": 1
      },
      {
       "function": "GetQuestVariable",
       "param1": "@CCCore",
       "param2": 2,
       "op": "==",
       "value": 0
      }
     ],
     "choices": [
      "@CCFoundTerms",
      "@CCFoundSign",
      "@CCFoundNo"
     ],
     "responses": [
      "Miss McLafferty lends to people who move goods between towns. Three thousand caps, four percent a week on what is left.",
      "Three hundred of the principal is due every week, and paying early costs nothing. You put in five hundred of your own.",
      "That buys a wagon, two brahmin, a driver, a guard and a trade licence. The rest is yours to trade with. Interested?"
     ]
    },
    {
     "key": "owner",
     "quest": "@CCFounding",
     "conditions": [
      {
       "function": "GetIsID",
       "param1": "@CCAgentHollis",
       "op": "==",
       "value": 1
      },
      {
       "function": "GetQuestVariable",
       "param1": "@CCCore",
       "param2": 2,
       "op": "==",
       "value": 1
      }
     ],
     "responses": [
      "The loan is signed. Orders go out from the terminal on my table, and the wagon leaves at six."
     ]
    }
   ]
  },
  "CCFoundTerms": {
   "type": "DIAL",
   "fields": [
    {
     "tag": "FULL",
     "text": "What happens if I miss a payment?"
    },
    {
     "tag": "DATA",
     "hex": "0000"
    }
   ],
   "infos": [
    {
     "key": "terms",
     "quest": "@CCFounding",
     "conditions": [
      {
       "function": "GetIsID",
       "param1": "@CCAgentHollis",
       "op": "==",
       "value": 1
      },
      {
       "function": "GetQuestVariable",
       "param1": "@CCCore",
       "param2": 2,
       "op": "==",
       "value": 0
      }
     ],
     "choices": [
      "@CCFoundSign",
      "@CCFoundNo"
     ],
     "responses": [
      "Miss a bill and you get a notice. Three days later a final one, then we take assets. Three strikes in eight weeks and the company is ours.",
      "Your own pocket stays yours. Your money can rescue you once after a miss, but the strike stands."
     ]
    }
   ]
  },
  "CCFoundSign": {
   "type": "DIAL",
   "fields": [
    {
     "tag": "FULL",
     "text": "I'll sign. Here are my 500 caps."
