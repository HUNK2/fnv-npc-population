     ],
     "result": "player.RemoveItem Caps001 500\nSetVariable \"iFoundNow\" 1 CCCore",
     "responses": [
      "Signed and witnessed. Your wagon and brahmin are behind Chet's store, and the board on his porch shows today's goods.",
      "The terminal on my table is your office. Orders go out at six in the morning. Do not make me come looking for you."
     ]
    },
    {
     "key": "sign_poor",
     "quest": "@CCFounding",
     "conditions": [
      {
       "function": "GetIsID",
       "param1": "@CCAgentHollis",
       "op": "==",
       "value": 1
      },
      {
       "function": "GetQuestVariable",
       "param1": "@CCCore",
       "param2": 2,
       "op": "==",
       "value": 0
      }
     ],
     "responses": [
      "Five hundred of your own, friend. The company does not lend to people with nothing in the pot."
     ]
    }
   ]
