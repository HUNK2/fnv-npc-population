scn CCTermDraw2

; The terminal screens of M1 task 1.8 (tools/terminal_model.py labels): 9 Staff, 10 Hire, 11 Candidate,
; 12 Contracts, 13 Standing orders, 14 Slot; and 1.9's 15 Build (CCBuildFn 0). Called by CCTermDraw; writes the rows and CCTerm.iRows.

int iScreen
int iPick
int iConfirm
int iRow
int iK
int iN
int iA
int iCover
int iDriver
int iSize
int iKind
int iTown
int iGood
int iValue
int iDay
array_var aSN
array_var aSR
array_var aSS
array_var aSW
array_var aCN
array_var aCR
array_var aCS
array_var aCH
array_var aCW
array_var aCU
array_var aCC
array_var aSK
array_var aST
array_var aSG
array_var aSV
array_var aMK
array_var aTrust
array_var aGood
array_var aRole
array_var aTownN
array_var aKindN
array_var aTraitN
int iTier
array_var aCT
array_var aCG
array_var aCP
array_var aCD
array_var aCM
string_var sT
string_var sN
string_var sR

begin Function {}
	let iScreen := GetVariable "iScreen" CCTerm
	let iPick := GetVariable "iPick" CCTerm
	let iConfirm := GetVariable "iConfirm" CCTerm
	let aGood := Ar_List "water", "powder", "ammo", "dirty", "herbs", "materials", "meat"
	let aRole := Ar_List "driver", "guard", "trader", "clerk"
	let aTownN := Ar_List "GS", "PR", "SL", "MO"
	let aKindN := Ar_List "empty", "keep stocked", "sell above", "pay at most"
	let aTraitN := Ar_List "", "Haggler", "Cautious", "Reckless", "Drinker", "NCR veteran", "Family man", "Ambitious", "Steady"
	set iRow to 0

	if iScreen == 9
		; Staff: the cover, everyone on the books (a second select fires), the hiring row
		let aSN := GetArrayVariable "aStaffName" CCCore
		let aSR := GetArrayVariable "aStaffRole" CCCore
		let aSS := GetArrayVariable "aStaffSkill" CCCore
		let aSW := GetArrayVariable "aStaffWage" CCCore
		let aCN := GetArrayVariable "aCandName" CCCore
		let iCover := call CCCoverFn
		if iCover > 0
			Console "SetTerminalMenuItemText CCOfficeTerm 1 0 %qCOVER %.0f on the road%q" iCover
		else
			Console "SetTerminalMenuItemText CCOfficeTerm 1 0 %qCOVER 0 on the road: NO DRIVER%q"
		endif
		set iRow to 1
		set iK to 0
		while iK < ar_Size aSN
			let sN := aSN[iK]
			if iConfirm && iPick == iK
				let sT := sv_Construct "FIRE %z? select again" sN
			else
				let sR := aRole[aSR[iK]]
				let iA := aSS[iK]
				let iN := aSW[iK]
				let sT := sv_Construct "%z  %z s%.0f %.0f/d" sN sR iA iN
			endif
			Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %q%z%q" iRow sT
			set iRow to iRow + 1
			set iK to iK + 1
		loop
		let iN := ar_Size aCN
		Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %qHIRE     %.0f asking for work%q" iRow iN
		set iRow to iRow + 1

	elseif iScreen == 10
		; Hire: this week's candidates
		let aCN := GetArrayVariable "aCandName" CCCore
		let aCR := GetArrayVariable "aCandRole" CCCore
		let aCS := GetArrayVariable "aCandSkill" CCCore
		let aCW := GetArrayVariable "aCandWage" CCCore
		set iK to 0
		while iK < ar_Size aCN
			let sN := aCN[iK]
			let sR := aRole[aCR[iK]]
			let iA := aCS[iK]
			let iN := aCW[iK]
			let sT := sv_Construct "%z  %z s%.0f %.0f/d" sN sR iA iN
			Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %q%z%q" iRow sT
			set iRow to iRow + 1
			set iK to iK + 1
		loop

	elseif iScreen == 11
		; Candidate: who (the rumour is the result text), hire, reference check
		let aCN := GetArrayVariable "aCandName" CCCore
		if eval (iPick < (ar_Size aCN))
			let aCR := GetArrayVariable "aCandRole" CCCore
			let aCS := GetArrayVariable "aCandSkill" CCCore
			let aCH := GetArrayVariable "aCandHon" CCCore
			let aCW := GetArrayVariable "aCandWage" CCCore
			let aCU := GetArrayVariable "aCandRumour" CCCore
			let aCC := GetArrayVariable "aCandChecked" CCCore
			let aSR := GetArrayVariable "aStaffRole" CCCore
			let sN := aCN[iPick]
			let sR := aRole[aCR[iPick]]
			let iA := aCS[iPick]
			let iN := aCW[iPick]
			let sT := sv_Construct "%z  %z s%.0f %.0f/d" sN sR iA iN
			Console "SetTerminalMenuItemText CCOfficeTerm 1 0 %q%z%q" sT
			let iA := aCH[iPick]
			if iA < 35
				let sR := "low"
			elseif iA < 70
				let sR := "fair"
			else
				let sR := "high"
			endif
			let sT := aCU[iPick]
			; M2 (tier 2): Nerve and the trait
			let iTier := GetVariable "iTier" CCCore
			if iTier >= 2
				let aCT := GetArrayVariable "aCandNerve" CCCore
				let iA := aCT[iPick]
				let sT := sv_Construct "%z Nerve %.0f." sT iA
				let aCT := GetArrayVariable "aCandTrait" CCCore
				if eval (aCT[iPick])
					let sN := aTraitN[aCT[iPick]]
					let sT := sv_Construct "%z %z." sT sN
				endif
			endif
			if eval (aCC[iPick])
				let sT := sv_Construct "%z Honesty: %z." sT sR
			endif
			Console "SetTerminalMenuItemText CCOfficeTerm 2 0 %q%z%q" sT
			; a driver for each wagon (wagon 1 and aWagonRoad)
			let aCT := GetArrayVariable "aWagonRoad" CCCore
			set iDriver to 0
			if eval (aCR[iPick] == 0)
				let iDriver := 0 - (ar_Size aCT)
				set iK to 0
				while iK < ar_Size aSR
					if eval (aSR[iK] == 0)
						set iDriver to iDriver + 1
					endif
					set iK to iK + 1
				loop
			endif
			set iRow to 2
			if eval ((ar_Size aSR) >= 10)
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qHIRE: the books are full (10)%q"
			elseif eval (iDriver > 0 && (ar_Size aCT) > 0)
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qHIRE: a driver for each wagon%q"
			elseif iDriver > 0
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qHIRE: one driver is enough%q"
			elseif iTier >= 2
				let iA := iN - 2
				if iA < 1
					set iA to 1
				endif
				let iK := iN + 3
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qHIRE fair, %.0f a day%q" iN
				Console "SetTerminalMenuItemText CCOfficeTerm 2 1 %qLoyalty starts at 55.%q"
				Console "SetTerminalMenuItemText CCOfficeTerm 1 2 %qHIRE low, %.0f a day%q" iA
				Console "SetTerminalMenuItemText CCOfficeTerm 2 2 %qLoyalty starts at 45.%q"
				Console "SetTerminalMenuItemText CCOfficeTerm 1 3 %qHIRE generous, %.0f a day%q" iK
				Console "SetTerminalMenuItemText CCOfficeTerm 2 3 %qLoyalty starts at 65.%q"
				set iRow to 4
			else
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qHIRE for %.0f a day%q" iN
			endif
			if eval (aCC[iPick])
				Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %qHONESTY  %z%q" iRow sR
			else
				Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %qREFERENCE CHECK  10 caps%q" iRow
			endif
			set iRow to iRow + 1
		endif

	elseif iScreen == 12
		; Contracts: the first contract's buyer's trust, then 3 rows for each running contract
		let aTrust := GetArrayVariable "aTrust" CCCore
		let aCT := GetArrayVariable "aConTown" CCCore
		set iK to 1
		if eval ((ar_Size aCT) > 0)
			let iK := aCT[0]
		endif
		let iA := aTrust[iK]
		let sR := call CCTextFn 3 iK
		let sT := sv_Construct "%z" sR
		let sT := sv_ToUpper sT
		Console "SetTerminalMenuItemText CCOfficeTerm 1 0 %q%z TRUST %.0f%q" sT iA
		set iRow to 1
		if eval ((ar_Size aCT) > 0)
			let aCG := GetArrayVariable "aConGood" CCCore
			let aCP := GetArrayVariable "aConPrice" CCCore
			let aCN := GetArrayVariable "aConNext" CCCore
			let aCS := GetArrayVariable "aConStart" CCCore
			let aCD := GetArrayVariable "aConDone" CCCore
			let aCM := GetArrayVariable "aConMissed" CCCore
			set iK to 0
			while iK < ar_Size aCT
				let iA := aCG[iK]
				let sR := call CCTextFn 4 iA
				let sT := sv_Construct "%z" sR
				let sT := sv_ToUpper sT
				let iA := aCP[iK]
				if eval (aCT[iK] == 1)
					Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %q%z 4 crates every 3d at %.0f%q" iRow sT iA
				else
					let sN := aTownN[aCT[iK]]
					Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %q%z 4 crates every 3d at %.0f to %z%q" iRow sT iA sN
				endif
				let iA := aCN[iK]
				let aCM := GetArrayVariable "aConNcr" CCLaw
				let iN := 28 + aCS[iK]
				if eval ((ar_Size aCM) > iK)
					let iN -= 14 * aCM[iK]
				endif
				let aCM := GetArrayVariable "aConMissed" CCCore
				set iRow to iRow + 1
				Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %qNEXT day %.0f  ENDS day %.0f%q" iRow iA iN
				let iA := aCD[iK]
				let iN := aCM[iK]
				set iRow to iRow + 1
				Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %qDELIVERED %.0f  MISSED %.0f%q" iRow iA iN
				set iRow to iRow + 1
				set iK to iK + 1
			loop
		else
			let aMK := GetArrayVariable "aMemoKind" CCCore
			set iN to 0
			set iK to 0
			while iK < ar_Size aMK
				if eval (aMK[iK] == 2)
					set iN to 1
				endif
				set iK to iK + 1
			loop
			if iN
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qAn offer is waiting in Memos.%q"
			else
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qNo contract running.%q"
			endif
			set iRow to 2
		endif
		; M4: a row for each forward ticket
		let iRow := call CCLateTextFn 6 iRow 0

	elseif iScreen == 13
		; Standing orders: the three slots
		let aSK := GetArrayVariable "aSOKind" CCCore
		let aST := GetArrayVariable "aSOTown" CCCore
		let aSG := GetArrayVariable "aSOGood" CCCore
		let aSV := GetArrayVariable "aSOValue" CCCore
		set iK to 0
		while iK < 3
			set iN to iK + 1
			let iKind := aSK[iK]
			let iValue := aSV[iK]
			let sN := aGood[aSG[iK]]
			if iKind == 0
				let sT := sv_Construct "SLOT %.0f  empty" iN
			elseif iKind == 1
				let sR := aTownN[aST[iK]]
				let sT := sv_Construct "SLOT %.0f  keep %z %.0f %z" iN sR iValue sN
			else
				let sR := aKindN[iKind]
				let sT := sv_Construct "SLOT %.0f  %z %z %.0f" iN sR sN iValue
			endif
			Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %q%z%q" iK sT
			set iK to iK + 1
		loop
		set iRow to 3

	elseif iScreen == 14
		; Slot: kind, then town, good, more, less
		let aSK := GetArrayVariable "aSOKind" CCCore
		let aST := GetArrayVariable "aSOTown" CCCore
		let aSG := GetArrayVariable "aSOGood" CCCore
		let aSV := GetArrayVariable "aSOValue" CCCore
		let iKind := aSK[iPick]
		let sT := aKindN[iKind]
		Console "SetTerminalMenuItemText CCOfficeTerm 1 0 %qKIND   %z%q" sT
		set iRow to 1
		if iKind
			if iKind == 1
				let sT := aTownN[aST[iPick]]
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qTOWN   %z%q" sT
			else
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qTOWN   any%q"
			endif
			let sT := aGood[aSG[iPick]]
			Console "SetTerminalMenuItemText CCOfficeTerm 1 2 %qGOOD   %z%q" sT
			let iValue := aSV[iPick]
			if iKind == 1
				Console "SetTerminalMenuItemText CCOfficeTerm 1 3 %qMORE   crates %.0f%q" iValue
			else
				Console "SetTerminalMenuItemText CCOfficeTerm 1 3 %qMORE   price %.0f%q" iValue
			endif
			Console "SetTerminalMenuItemText CCOfficeTerm 1 4 %qLESS%q"
			set iRow to 5
		endif
	endif

	if iScreen == 15
		let iRow := call CCBuildFn 0
	elseif iScreen == 16
		let iRow := call CCTownsFn 0 0
	endif

	Console "SetTerminalMenuItemText CCOfficeTerm 1 %.0f %qBACK%q" iRow
	set iN to iRow + 1
	SetVariable "iRows" iN CCTerm
end
