scn CCLawFn

; M3: the rival and the law (tools/law_model.py LawMixin; plan docs/plans/2026-11-28-m3-rival-law.md).
; The state is CCLaw's (CCLawScript); every act first sets it up once (an M2 save gets aggression 20,
; standing 30, and an inspection 30 days out when it is at tier 3 already).
; iAct 0: the tick starts: clear the day's news.
; iAct 1: bill day (Company._bills): returns the 8 bills (wages, duty, rent, feed, licence, cover, interest,
;         principal); duty is on the declared share of the week's sales, the licence by tier, the cover
;         premium 40 a running wagon; the hidden share is kept for the next inspection and makes heat.
; iAct 2: the post (Company._post_ncr): the NCR's weekly ammo bid as a memo (kind 4, aMemoX the market price).
; iAct 3: settle memo iA (kind 4 NCR bid, 5 warrant) with answer iB (-1: the default).
; iAct 4: the week (Company._week_law). iAct 5: the day (Company._day_law).
; iAct 6: returns 1 when tier 4 is earned (worth iA, iB 1 when a strike is recent). iAct 7: the tier 3 day.
; iAct 10: road iA's wagon runs: the Outpost toll and a sealed-crate run (Company._toll, _sealed_run).
; iAct 11: a road loss of iA caps: returns what Crimson Cover pays back (Company._claim).
; iAct 12: iB % 100 crates sold in town iA; iB >= 100: an NCR contract delivery.
; iAct 20, 21, 22: the Towns screen's law rows: cycle the declared share, sealed crates, Crimson Cover.

int iAct
int iA
int iB
int iOut
int iDay
int iTier
int iCash
int iCosts
int iK
int iN
int iJ
int iT
int iPay
int iHeat
int iBase
int iHi
int iLo
int iTop
int iAggr
int iFault
float fM
float fBest
float fUse
array_var aBill
array_var aRun
array_var aSold
array_var aLast
array_var aSh
array_var aUse
array_var aMkt
array_var aSN
array_var aSL
array_var aMK
array_var aNc
array_var aX
string_var sName

begin Function {iAct iA iB}
	set iOut to 0
	let iDay := GetVariable "iDay" CCCore
	let iTier := GetVariable "iTier" CCCore
	if eval ((GetVariable "iInit" CCLaw) == 0)
		SetVariable "iInit" 1 CCLaw
		SetVariable "iAggr" 20 CCLaw
		SetVariable "iStanding" 30 CCLaw
		set iN to 0 - 99
		SetVariable "iSealedLast" iN CCLaw
		SetVariable "iRaidLast" iN CCLaw
		SetVariable "iLastNcr" iN CCLaw
		let CCLaw.aSoldWk := Ar_List 0, 0, 0, 0
		let CCLaw.aLastShare := Ar_List 0, 0, 0, 0
		let CCLaw.aRaids := Ar_Construct "array"
		let CCLaw.aConNcr := Ar_Construct "array"
		let CCLaw.sPoach := " "
		let CCLaw.sDWho := " "
		let aX := GetArrayVariable "aConTown" CCCore
		let aNc := GetArrayVariable "aConNcr" CCLaw
		while (ar_Size aNc) < (ar_Size aX)
			ar_Append aNc 0
		loop
		if iTier >= 3
			set iN to iDay + 30
			SetVariable "iInspNext" iN CCLaw
		endif
	endif

	if iAct == 0
		SetVariable "iDToll" 0 CCLaw
		SetVariable "iDSealed" 0 CCLaw
		SetVariable "iDClaim" 0 CCLaw
		SetVariable "iDRival" 0 CCLaw
		SetVariable "iDWarrant" 0 CCLaw
		SetVariable "iDInsp" 0 CCLaw
		SetVariable "iDFine" 0 CCLaw
		SetVariable "iDRaid" 0 CCLaw
		SetVariable "iDRaidLoss" 0 CCLaw
		SetVariable "iDNcr" 0 CCLaw

	elseif iAct == 1
		let iN := GetVariable "iWeekSales" CCCore
		let iK := GetVariable "iHide" CCLaw
		let fM := (iK == 1) * 0.1 + (iK == 2) * 0.2
		let iJ := Floor (fM * iN + 0.5)
		let iT := (GetVariable "iHidden" CCLaw) + iJ
		SetVariable "iHidden" iT CCLaw
		let iT := (GetVariable "iHeatGain" CCLaw) + 2 * iK
		SetVariable "iHeatGain" iT CCLaw
		set iN to iN - iJ
		; NCR duty on the declared sales: 2%, 3.5% on the part above 5,000, 5% above 20,000
		let fM := 0.02 * iN
		if iN > 5000
			let fM := 0.02 * 5000 + 0.035 * ((iN < 20000) * iN + (iN >= 20000) * 20000 - 5000)
		endif
		if iN > 20000
			let fM := fM + 0.05 * (iN - 20000)
		endif
		let aBill := Ar_List 0, 0, 70, 0, 0, 0, 0, 0
		let aBill[0] := GetVariable "iAccWages" CCCore
		let aBill[1] := Floor (fM + 0.5)
		let aBill[3] := GetVariable "iAccFeed" CCCore
		if eval (iDay % 28 == 0)
			let aBill[4] := 150 + (iTier == 3) * 250 + (iTier >= 4) * 750
		endif
		if eval (GetVariable "iInsured" CCLaw)
			let aRun := call CCRoadsFn 0 iDay
			let aBill[5] := 40 * ((aRun[1] > 0) + (aRun[2] > 0) + (aRun[3] > 0))
		endif
		let iN := GetVariable "iLoan" CCCore
		let aBill[6] := Floor (0.04 * iN + 0.5)
		if iN < 300
			let aBill[7] := iN
		else
			let aBill[7] := 300
		endif
		SetFunctionValue aBill
		return

	elseif iAct == 2
		; tier 3, heat under 60, not outlaws, the Outpost road running, day 5 of a week, a week since the
		; last offer, no NCR contract or bid waiting, room for the memo
		let aMK := GetArrayVariable "aMemoKind" CCCore
		let aNc := GetArrayVariable "aConNcr" CCLaw
		set iN to 0
		set iK to 0
		while iK < ar_Size aMK
			if eval (aMK[iK] == 4)
				set iN to 1
			endif
			set iK to iK + 1
		loop
		set iK to 0
		while iK < ar_Size aNc
			if eval (aNc[iK])
				set iN to 1
			endif
			set iK to iK + 1
		loop
		let aRun := call CCRoadsFn 0 iDay
		if eval (iTier >= 3 && (GetVariable "iHeat" CCLaw) < 60 && (GetVariable "iOutlaw" CCLaw) == 0 && aRun[3] > 0 && iDay % 7 == 5 && iDay - (GetVariable "iLastNcr" CCLaw) >= 7 && iN == 0 && (ar_Size aMK) < 3)
			let aX := GetArrayVariable "aNormal" CCCore
			let fM := aX[38]
			let aX := GetArrayVariable "aAnchor" CCCore
			let fBest := aX[2]
			let aX := GetArrayVariable "aUse" CCCore
			let fUse := aX[38]
			let aX := GetArrayVariable "aTrust" CCCore
			let iT := aX[3]
			let iBase := call CCPriceFn fBest, fM, fUse, iT, 41
			ar_Append aMK 4
			let aX := GetArrayVariable "aMemoDay" CCCore
			ar_Append aX iDay
			let aX := GetArrayVariable "aMemoDue" CCCore
			ar_Append aX (iDay + 1)
			let aX := GetArrayVariable "aMemoPick" CCCore
			ar_Append aX (0 - 1)
			let aX := GetArrayVariable "aMemoX" CCCore
			ar_Append aX iBase
			let aX := GetArrayVariable "aMemoWho" CCCore
			ar_Append aX " "
			SetVariable "iLastNcr" iDay CCLaw
			set iOut to 1
		endif

	elseif iAct == 3
		let aMK := GetArrayVariable "aMemoKind" CCCore
		let iCash := GetVariable "iCash" CCCore
		let iCosts := GetVariable "iDayCosts" CCCore
		if eval (aMK[iA] == 4)
			; the NCR bid: 0 bid 1.3 times the market, 1 bid 1.2, 2 pass (the default); the Crimson Caravan
			; bids 1.25 from aggression 40, so then only the low bid wins
			if iB < 0
				set iB to 2
			endif
			let aX := GetArrayVariable "aMemoX" CCCore
			let iBase := aX[iA]
			let iHi := Floor (1.3 * iBase + 0.5)
			let iLo := Floor (1.2 * iBase + 0.5)
			let iAggr := GetVariable "iAggr" CCLaw
			if iB == 0 && iAggr >= 40
				SetVariable "iDNcr" 2 CCLaw
			elseif iB < 2
				set iPay to iLo
				if iB == 0
					set iPay to iHi
				endif
				; an Outpost ammo contract from Primm on the Outpost road: 4 crates every 3 days for 14 days
				let aX := GetArrayVariable "aConTown" CCCore
				ar_Append aX 3
				let aX := GetArrayVariable "aConGood" CCCore
				ar_Append aX 2
				let aX := GetArrayVariable "aConRoad" CCCore
				ar_Append aX 3
				let aX := GetArrayVariable "aConOrigin" CCCore
				ar_Append aX 1
				let aX := GetArrayVariable "aConPrice" CCCore
				ar_Append aX iPay
				let aX := GetArrayVariable "aConStart" CCCore
				ar_Append aX iDay
				let aX := GetArrayVariable "aConNext" CCCore
				ar_Append aX iDay
				let aX := GetArrayVariable "aConDone" CCCore
				ar_Append aX 0
				let aX := GetArrayVariable "aConMissed" CCCore
				ar_Append aX 0
				let aX := GetArrayVariable "aConNcr" CCLaw
				ar_Append aX 1
				set iAggr to iAggr + 5
				if iAggr > 100
					set iAggr to 100
				endif
				SetVariable "iAggr" iAggr CCLaw
				SetVariable "iDaySigned" iPay CCCore
				SetVariable "iDayConTG" 302 CCCore
				SetVariable "iDNcr" 1 CCLaw
			endif
		else
			; a warrant: 0 pay a fixer 300 to lose the papers, 1 let them come (the default): the raid on
			; paper, guard cover against strength 60
			if iB < 0
				set iB to 1
			endif
			if iB == 0 && iCash >= 300
				set iCash to iCash - 300
				set iCosts to iCosts + 300
				SetVariable "iHeat" 50 CCLaw
				SetVariable "iRaidLast" iDay CCLaw
				SetVariable "iDRaid" 3 CCLaw
			else
				let iN := call CCCoverFn
				if iN >= 60
					SetVariable "iOutlaw" 1 CCLaw
					SetVariable "iStanding" 0 CCLaw
					SetVariable "iDRaid" 1 CCLaw
				else
					let iPay := Floor (0.2 * iCash + 0.5)
					set iCash to iCash - iPay
					set iCosts to iCosts + iPay
					SetVariable "iDRaid" 2 CCLaw
					SetVariable "iDRaidLoss" iPay CCLaw
				endif
				; a second raid within 28 days: the NCR revokes the licence
				let aX := GetArrayVariable "aRaids" CCLaw
				set iN to 0
				set iK to 0
				while iK < ar_Size aX
					if eval (iDay - aX[iK] <= 28)
						set iN to 1
					endif
					set iK to iK + 1
				loop
				ar_Append aX iDay
				SetVariable "iHeat" 50 CCLaw
				SetVariable "iRaidLast" iDay CCLaw
				if iN
					SetVariable "iEnded" 1 CCCore
					SetVariable "iEndReason" 4 CCCore
				endif
			endif
		endif
		SetVariable "iCash" iCash CCCore
		SetVariable "iDayCosts" iCosts CCCore

	elseif iAct == 4
		let aSold := GetArrayVariable "aSoldWk" CCLaw
		if iTier >= 3
			if (GetVariable "iBillsPaid" CCCore) == 1
				let iN := (GetVariable "iStanding" CCLaw) + 1
				if iN > 100
					set iN to 100
				endif
				SetVariable "iStanding" iN CCLaw
			endif
			; each town's share this week: the company's crates over 7 days of the town's use
			let aUse := GetArrayVariable "aUse" CCCore
			let aMkt := GetArrayVariable "aMkt" CCCore
			let aLast := GetArrayVariable "aLastShare" CCLaw
			let aSh := Ar_List 0, 0, 0, 0
			set iTop to 0
			set iT to 0
			while iT < 4
				set fUse to 0
				set iK to 0
				while iK < 7
					if eval (aMkt[iT * 12 + iK])
						let fUse := fUse + aUse[iT * 12 + iK]
					endif
					set iK to iK + 1
				loop
				let aSh[iT] := aSold[iT] / (7 * fUse)
				if eval (aSh[iT] > aSh[iTop])
					set iTop to iT
				endif
				set iT to iT + 1
			loop
			let iAggr := GetVariable "iAggr" CCLaw
			if eval (aSh[iTop] > 0.25 && aSh[iTop] > aLast[iTop])
				set iAggr to iAggr + 10
				if iAggr > 100
					set iAggr to 100
				endif
			elseif eval (aSh[iTop] < 0.05)
				set iAggr to iAggr - 5
				if iAggr < 0
					set iAggr to 0
				endif
			endif
			SetVariable "iAggr" iAggr CCLaw
			if iAggr >= 30
				if eval (aSh[iTop] > 0.25 && iDay > (GetVariable "iWarUntil" CCLaw))
					; a price war: her caravans undercut the company's sales in that town for 5 days
					set iN to iTop + 1
					SetVariable "iWarTown" iN CCLaw
					set iN to iDay + 5
					SetVariable "iWarUntil" iN CCLaw
					SetVariable "iDRival" 1 CCLaw
				else
					; Alice courts the least loyal person under 40
					let aSN := GetArrayVariable "aStaffName" CCCore
					let aSL := GetArrayVariable "aStaffLoyal" CCCore
					set iJ to 0 - 1
					set iK to 0
					while iK < ar_Size aSL
						if eval (aSL[iK] < 40)
							if iJ < 0
								set iJ to iK
							elseif eval (aSL[iK] < aSL[iJ])
								set iJ to iK
							endif
						endif
						set iK to iK + 1
					loop
					if iJ >= 0
						let CCLaw.sPoach := aSN[iJ]
						let CCLaw.sDWho := aSN[iJ]
						set iN to iDay + 1
						SetVariable "iPoachDay" iN CCLaw
						SetVariable "iDRival" 2 CCLaw
					endif
				endif
			endif
			set iK to 0
			while iK < 4
				let aLast[iK] := aSh[iK]
				set iK to iK + 1
			loop
		endif
		set iK to 0
		while iK < 4
			let aSold[iK] := 0
			set iK to iK + 1
		loop

	elseif iAct == 5
		; a warned poach happens unless the person's loyalty reached 40
		let sName := CCLaw.sPoach
		if eval ((sv_Length sName) > 1 && iDay >= (GetVariable "iPoachDay" CCLaw))
			let aSN := GetArrayVariable "aStaffName" CCCore
			let aSL := GetArrayVariable "aStaffLoyal" CCCore
			set iK to 0
			while iK < ar_Size aSN
				if eval (aSN[iK] == sName)
					if eval (aSL[iK] < 40)
						call CCStaffFn 2 iK
						let CCLaw.sDWho := sName
						SetVariable "iDRival" 3 CCLaw
					endif
					set iK to 99
				endif
				set iK to iK + 1
			loop
			let CCLaw.sPoach := " "
		endif
		; heat: today's gains, or it cools 1 a day, 2 after 7 clean days
		let iHeat := GetVariable "iHeat" CCLaw
		let iN := GetVariable "iHeatGain" CCLaw
		if iN > 0
			set iHeat to iHeat + iN
			if iHeat > 100
				set iHeat to 100
			endif
			SetVariable "iClean" 0 CCLaw
		else
			let iK := (GetVariable "iClean" CCLaw) + 1
			SetVariable "iClean" iK CCLaw
			let iHeat := iHeat - 1 - (iK >= 7)
			if iHeat < 0
				set iHeat to 0
			endif
		endif
		SetVariable "iHeat" iHeat CCLaw
		SetVariable "iHeatGain" 0 CCLaw
		if iTier >= 3
			if iDay >= (GetVariable "iInspNext" CCLaw)
				; the NCR inspects the books: hidden sales or unpaid bills are a fault; the second one fines
				; 5% of the last 7 days' sales
				set iFault to 0
				if (GetVariable "iHidden" CCLaw) > 0 || (GetVariable "iArrears" CCCore) > 0
					set iFault to 1
					let iN := (GetVariable "iFaults" CCLaw) + 1
					SetVariable "iFaults" iN CCLaw
					let iK := (GetVariable "iStanding" CCLaw) - 5
					if iK < 0
						set iK to 0
					endif
					SetVariable "iStanding" iK CCLaw
					if iN > 1
						let aX := GetArrayVariable "aHistSales" CCCore
						let iJ := GetVariable "iDaySales" CCCore
						let iK := (ar_Size aX) - 6
						if iK < 0
							set iK to 0
						endif
						while iK < ar_Size aX
							let iJ += aX[iK]
							set iK to iK + 1
						loop
						let iPay := Floor (0.05 * iJ + 0.5)
						let iCash := GetVariable "iCash" CCCore
						if iPay > iCash
							set iPay to iCash
						endif
						set iCash to iCash - iPay
						SetVariable "iCash" iCash CCCore
						let iN := (GetVariable "iDayCosts" CCCore) + iPay
						SetVariable "iDayCosts" iN CCCore
						SetVariable "iDFine" iPay CCLaw
					endif
				endif
				set iN to iFault + 1
				SetVariable "iDInsp" iN CCLaw
				SetVariable "iHidden" 0 CCLaw
				let iN := iDay + 30 - 20 * (iHeat >= 20)
				SetVariable "iInspNext" iN CCLaw
			endif
			; heat 80: a warrant (memo kind 5, due in 7 days), not within 7 days of the last raid
			let aMK := GetArrayVariable "aMemoKind" CCCore
			set iN to 0
			set iK to 0
			while iK < ar_Size aMK
				if eval (aMK[iK] == 5)
					set iN to 1
				endif
				set iK to iK + 1
			loop
			if eval (iHeat >= 80 && iDay - (GetVariable "iRaidLast" CCLaw) >= 7 && iN == 0 && (ar_Size aMK) < 3)
				ar_Append aMK 5
				let aX := GetArrayVariable "aMemoDay" CCCore
				ar_Append aX iDay
				let aX := GetArrayVariable "aMemoDue" CCCore
				ar_Append aX (iDay + 7)
				let aX := GetArrayVariable "aMemoPick" CCCore
				ar_Append aX (0 - 1)
				let aX := GetArrayVariable "aMemoX" CCCore
				ar_Append aX 0
				let aX := GetArrayVariable "aMemoWho" CCCore
				ar_Append aX " "
				SetVariable "iDWarrant" 1 CCLaw
			endif
		endif

	elseif iAct == 6
		; tier 4 (Company.tier_four_ready): worth 40,000, the loan repaid, no arrears, NCR standing 50, an
		; NCR delivery made, not outlaws, no recent strike
		if iTier == 3 && iA >= 40000 && iB == 0
			if eval ((GetVariable "iLoan" CCCore) == 0 && (GetVariable "iArrears" CCCore) == 0 && (GetVariable "iStanding" CCLaw) >= 50 && (GetVariable "iNcrDone" CCLaw) >= 1 && (GetVariable "iOutlaw" CCLaw) == 0)
				set iOut to 1
			endif
		endif

	elseif iAct == 7
		set iN to iDay + 30
		SetVariable "iInspNext" iN CCLaw

	elseif iAct == 10
		let iCash := GetVariable "iCash" CCCore
		let iCosts := GetVariable "iDayCosts" CCCore
		; the Outpost toll on road 3 (a trading house rides free)
		if iA == 3 && iTier < 4
			set iPay to 20
			if iPay > iCash
				set iPay to iCash
			endif
			set iCash to iCash - iPay
			set iCosts to iCosts + iPay
			let iN := (GetVariable "iDToll" CCLaw) + iPay
			SetVariable "iDToll" iN CCLaw
		endif
		; a sealed crate on the Primm road: 50 off the books, at most every 3 days; a patrol searches 1 in 10
		if eval (iA == 1 && iTier >= 3 && (GetVariable "iSealed" CCLaw) && iDay - (GetVariable "iSealedLast" CCLaw) >= 3)
			SetVariable "iSealedLast" iDay CCLaw
			set iCash to iCash + 50
			let iN := (GetVariable "iDaySales" CCCore) + 50
			SetVariable "iDaySales" iN CCCore
			let iN := (GetVariable "iHeatGain" CCLaw) + 5
			SetVariable "iHeatGain" iN CCLaw
			SetVariable "iDSealed" 1 CCLaw
			let iK := GetVariable "iSeed" CCCore
			if eval (((iDay % 100) * 19 + (iK % 100) * 29 + 217) % 100 < 10)
				set iPay to 100
				if iPay > iCash
					set iPay to iCash
				endif
				set iCash to iCash - iPay
				set iCosts to iCosts + iPay
				let iN := (GetVariable "iHeatGain" CCLaw) + 10
				SetVariable "iHeatGain" iN CCLaw
				SetVariable "iDSealed" 2 CCLaw
			endif
		endif
		SetVariable "iCash" iCash CCCore
		SetVariable "iDayCosts" iCosts CCCore

	elseif iAct == 11
		if eval ((GetVariable "iInsured" CCLaw) && iA > 0)
			let iOut := Floor (0.6 * iA + 0.5)
			let iN := (GetVariable "iDaySales" CCCore) + iOut
			SetVariable "iDaySales" iN CCCore
			SetVariable "iDClaim" iOut CCLaw
		endif

	elseif iAct == 12
		let aSold := GetArrayVariable "aSoldWk" CCLaw
		let aSold[iA] := aSold[iA] + iB % 100
		if iB >= 100
			let iN := (GetVariable "iStanding" CCLaw) + 2
			if iN > 100
				set iN to 100
			endif
			SetVariable "iStanding" iN CCLaw
			let iN := (GetVariable "iNcrDone" CCLaw) + 1
			SetVariable "iNcrDone" iN CCLaw
		endif

	elseif iAct >= 20 && iTier >= 3 && (GetVariable "iEnded" CCCore) == 0
		if iAct == 20
			let iN := ((GetVariable "iHide" CCLaw) + 1) % 3
			SetVariable "iHide" iN CCLaw
		elseif iAct == 21
			let iN := 1 - (GetVariable "iSealed" CCLaw)
			SetVariable "iSealed" iN CCLaw
		else
			let iN := 1 - (GetVariable "iInsured" CCLaw)
			SetVariable "iInsured" iN CCLaw
		endif
		set iOut to 1
	endif
	SetFunctionValue iOut
end
