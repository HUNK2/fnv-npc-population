scn CCNoticeFn

; Notice texts (tools/post_model.py notice_text, forecast_text, letter_title; tools/terminal_model.py
; notice_row). iWhat: 0 the notice text (a deferred notice is written as it will be once served; with
; no notice open, the forecast or "No notice"), 1 the front page's NOTICE row, 2 a notice letter's title.

int iWhat
int iStage
int iSt
int iDay
int iArrears
int iServed
int iStageDay
int iAtFinal
int iFromProb
int iCash
int iLoan
int iHands
int iWeek
int iN
int iK
int iNeed
int iDays
int iStrikes
int iWages
int iInt
int iPrin
int iEst
int iBurn
int iRun
int iDtb
int iShort
float fM
array_var aS
string_var sOut

begin Function {iWhat}
	let iStage := GetVariable "iStage" CCCore
	let iDay := GetVariable "iDay" CCCore
	let iArrears := GetVariable "iArrears" CCCore
	let iServed := GetVariable "iServedDay" CCCore
	let iStageDay := GetVariable "iStageDay" CCCore
	let iAtFinal := GetVariable "iArrearsAtFinal" CCCore
	let iFromProb := GetVariable "iFromProb" CCCore
	let iCash := GetVariable "iCash" CCCore
	let iLoan := GetVariable "iLoan" CCCore
	let iHands := GetVariable "iHands" CCCore
	let iWeek := GetVariable "iWeekSales" CCCore
	let aS := GetArrayVariable "aStrikes" CCCore
	set iN to 0
	set iK to 0
	while iK < ar_Size aS
		if eval (iDay - aS[iK] < 56)
			set iN to iN + 1
		endif
		set iK to iK + 1
	loop

	; the stage, what to pay, the days left and the strikes (Company.notice_values)
	set iNeed to iArrears
	if iStage == 1
		set iStrikes to iN + 1
		if iArrears == 0
			set iSt to 5
			set iDays to 14
		elseif iN + 1 >= 3
			set iSt to 6
			set iDays to 7
		elseif iFromProb
			set iSt to 3
			set iDays to 2
			let iNeed := iArrears - Floor (0.4 * iArrears)
		else
			set iSt to 2
			set iDays to 3
		endif
	else
		set iSt to iStage
		set iStrikes to iN
		set iDays to 0
		if iStage == 2
			set iDays to 3 - (iDay - iServed)
		elseif iStage == 3
			set iDays to 5 - (iDay - iServed)
			let iNeed := iArrears - Floor (0.4 * iAtFinal)
			if iNeed < 0
				set iNeed to 0
			endif
		elseif iStage == 4 || iStage == 6
			set iDays to 7 - (iDay - iServed)
		elseif iStage == 5
			set iDays to 14 - (iDay - iStageDay)
		endif
		if iDays < 0
			set iDays to 0
		endif
	endif

	; the forecast: runway under 5 days and no notice open (Company.forecast_short)
	set iShort to 0
	let iDtb := 7 - iDay % 7
	if iStage == 0 || iStage == 5
		set iWages to 22 + 14 * iHands
		let iInt := Floor (0.04 * iLoan + 0.5)
		set iPrin to 300
		if iLoan < 300
			set iPrin to iLoan
		endif
		let fM := 0.02 * iWeek
		if iWeek > 5000
			let fM := 0.02 * 5000 + 0.035 * ((iWeek < 20000) * iWeek + (iWeek >= 20000) * 20000 - 5000)
		endif
		if iWeek > 20000
			let fM := fM + 0.05 * (iWeek - 20000)
		endif
		let iEst := 7 * iWages + 42 + 70 + iInt + iPrin + Floor (fM + 0.5)
		if eval ((iDay + iDtb) % 28 == 0)
			set iEst to iEst + 150
		endif
		let iBurn := Floor (iWages + 6 + (70 + iInt + iPrin) / 7 + 0.5)
		if iBurn < 1
			set iBurn to 1
		endif
		let iRun := Floor (iCash / iBurn)
		if iRun < 5
			set iShort to iEst - iCash
			if iShort < 1
				set iShort to 1
			endif
		endif
	endif

	if iWhat == 0
		if iSt == 2
			let sOut := sv_Construct "Boss, we missed bill day. %.0f is owed to the lender. Pay it within %.0f days or a final notice follows. Strike %.0f of 3 this season." iArrears iDays iStrikes
		elseif iSt == 3
			let sOut := sv_Construct "Final notice: %.0f is owed. Pay %.0f of it within %.0f days or the lender takes the wagon and brahmin. Strike %.0f of 3 this season." iArrears iNeed iDays iStrikes
		elseif iSt == 4
			let sOut := sv_Construct "The lender's men took the wagon and brahmin. %.0f is still owed. Pay it within %.0f days or the office becomes a Crimson Caravan branch." iArrears iDays
		elseif iSt == 6
			let sOut := sv_Construct "Third strike this season: a takeover notice. Pay %.0f from company cash within %.0f days or the lender takes the office. Your own caps will not do." iArrears iDays
		elseif iSt == 5
			let sOut := sv_Construct "We missed bill day, but it is paid now. The lender still marks a strike, %.0f of 3 this season. Probation for %.0f days." iStrikes iDays
		elseif iShort > 0
			let sOut := sv_Construct "Boss, cash is thin: at this rate we are short by about %.0f caps on bill day, in %.0f days, unless sales pick up." iShort iDtb
		else
			let sOut := "No notice. The bills are paid on time."
		endif
	elseif iWhat == 1
		if iShort > 0
			let sOut := sv_Construct "WARNING  short ~%.0f on bill day" iShort
		elseif iStage == 0
			let sOut := "NOTICE   none"
		elseif iStage == 1
			let sOut := sv_Construct "NOTICE   unread: %.0f owed" iArrears
		elseif iStage == 5
			let sOut := sv_Construct "NOTICE   probation, %.0fd left" iDays
		elseif iStage == 2
			let sOut := sv_Construct "NOTICE   SERVED: %.0f owed, %.0fd" iArrears iDays
		elseif iStage == 3
			let sOut := sv_Construct "NOTICE   FINAL: pay %.0f in %.0fd" iNeed iDays
		elseif iStage == 4
			let sOut := sv_Construct "NOTICE   SEIZED: %.0f owed, %.0fd" iArrears iDays
		else
			let sOut := sv_Construct "NOTICE   TAKEOVER: %.0f owed, %.0fd" iArrears iDays
		endif
	else
		if iSt == 2
			let sOut := sv_Construct "LETTER day %.0f  notice served" iDay
		elseif iSt == 3
			let sOut := sv_Construct "LETTER day %.0f  final notice" iDay
		elseif iSt == 4
			let sOut := sv_Construct "LETTER day %.0f  wagon seized" iDay
		elseif iSt == 6
			let sOut := sv_Construct "LETTER day %.0f  takeover notice" iDay
		else
			let sOut := sv_Construct "LETTER day %.0f  strike" iDay
		endif
	endif
	SetFunctionValue sOut
end
