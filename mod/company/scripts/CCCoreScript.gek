scn CCCoreScript

; Mojave Caravan Company: the ledger and the day tick (M1 plan task 1.3).
; tools/company_model.py is the spec: same formulas, same order, whole caps rounded half up, the
; same seeded rolls. Towns: 0 Goodsprings, 1 Primm. Goods: 0 purified water, 1 healing powder,
; 2 ammo, 3 dirty water, 4 herbs, 5 building materials. Town-good cells are index town*6 + good.
; The company day ticks at 06:00 game time; missed days run in order, at most 14 per script run.
; Variables are only ever appended (saves keep them by index); one GameMode block, no early return.
; The post (plan task 1.6, texts in tools/post_model.py): memos (aMemo*: kind 0 road, 1 prepay; pick
; -1 unanswered), tomorrow's forecast, the report's two pages (aPage), the last 3 letter texts (aPost*) and
; the one letter waiting to be shown in the field (iLetterKind 1 robbed, 2 road, 3 away, 4 notice,
; 5 forecast, 6 closed, 7 tier; aLetter[0]).
; The debt ladder (plan task 1.7): iStage 0 none, 1 deferred, 2 grace, 3 final notice, 4 seized,
; 5 probation, 6 takeover. A missed bill is deferred until its notice is served (CCServeFn: at a terminal
; or by its field letter); cures in CCCureFn; texts in CCNoticeFn; the busy shield is CCShieldFn.
; iEndReason 1 receivership, 2 takeover, 3 walked away.
; Staff, contracts, standing orders (plan task 1.8): paper staff in aStaff* (role 0 driver, 1 guard),
; this week's candidates in aCand* (CCStaffFn), cover from CCCoverFn and wages from CCWagesFn; one
; supply contract (iCon*: 4 crates of water to Primm every 3 days for 28 days; memo kind 2 is its
; offer at iOfferPrice); three standing order slots aSO* (kind 0 empty, 1 keep stocked, 2 sell above,
; 3 pay at most) used by CCPlanFn.
; M2 (plan 2.3 to 2.5; iInit 5, CCUpgradeFn): towns 0 Goodsprings, 1 Primm, 2 Sloan, 3 Mojave Outpost;
; 11 goods (6 smoked meat; site goods 7 brahmin, 8 stone, 9 sand, 10 scrap), cells town*12 + good, a
; warehouse per town (aWh), markets in aMkt. Roads 1 Goodsprings - Primm, 2 Goodsprings - Sloan, 3 Primm -
; Outpost; wagons 2 and 3 in aWagonRoad/aWagonOk (CCRoadsFn); the trips in CCTripFn, sites, workshops and
; town levels in CCWorkFn, loyalty and the bookkeeper in CCPeopleFn, contracts in the aCon* arrays
; (CCContractFn). Memo kind 3 is a raise (aMemoWho); aMemoX carries a memo's road or contract offer.

int iInit
int iFounded
int iEnded
int iSeed
int iDay
int iLastClock
int iClock
int iTier
int iCash
int iOwner
int iOwnerPaidIn
int iLoan
int iAssets
int iSheriff
int iPresent
int iShield
int iAuto
int iFoundNow
int iWeekSales
int iAccWages
int iAccFeed
int iArrears
int iStage
int iServedDay
int iStageDay
int iArrearsAtFinal
int iLastEventDay
int iWagonOk
int iGhostTown
int iHands
int iDaySales
int iDayCosts
int iDayLoss
int iDayEvent
int iBillsPaid
int iBillTotal
int iRuns
int iT
int iG
int iK
int iN
int iI
int iLeg
int iOrigin
int iDest
int iBest
int iBestG
int iBestOwn
int iBestCost
int iCost
int iSale
int iOwn
int iLost
int iCap
int iValue
int iWreck
int iChance
int iBurn
int iPay
int iTake
int iCode
int iPlanCash
int iBill
float fM
array_var aStock
array_var aUse
array_var aNormal
array_var aAnchor
array_var aTrust
array_var aWh
array_var aQueue
array_var aLeg
array_var aLegCost
array_var aSo
array_var aSd
array_var aWhPlan
array_var aStrikes
array_var aWorkshops
array_var aSites
array_var aHistCash
array_var aHistSales
array_var aHistCosts
array_var aHistEvent
array_var aHistLoss
array_var aBill
array_var aKeep
int iRoadMode
int iForecast
int iLastVisit
int iAwayPosted
int iLetterKind
int iLetterShownDay
int iPrepaid
int iDayOut
int iDayBack
int iDayMode
int iDayWagon
int iFires
int iClean
int iRoadPosted
int iNewKind
int iDtb
int iEst
int iRun
int iJ
int iSumS
int iSumC
array_var aMemoKind
array_var aMemoDay
array_var aMemoDue
array_var aMemoPick
array_var aPage
array_var aLetter
array_var aPostText
array_var aPostTitle
string_var sS
string_var sP1
string_var sNew
int iFromProb
int iEndReason
int iLastRescue
int iBuildings
int iForecastBill
int iShieldTest
int iStageNote
int iShort
int iMargin
int iWages
int iCover
int iInTick
int iConOn
int iConPrice
int iConStart
int iConNext
int iConDone
int iConMissed
int iLastOffer
int iOfferPrice
int iDayCon
int iDaySigned
int iDayCrew
int iLoaded
int iTripRuns
int iLegCap
int iSkim
array_var aStaffName
array_var aStaffRole
array_var aStaffSkill
array_var aStaffHon
array_var aStaffWage
array_var aCandName
array_var aCandRole
array_var aCandSkill
array_var aCandHon
array_var aCandWage
array_var aCandRumour
array_var aCandChecked
array_var aSOKind
array_var aSOTown
array_var aSOGood
array_var aSOValue
int iGhostPaid
int iTierUp
float fCut
int iHireOffer
int iBookkeeper
int iRouteMgr
int iGangersTown
int iEvRoad
int iBoughtDay
int iBoughtToday
int iDeedQuarry
int iNeedFounders
array_var aMkt
array_var aBaseUse
array_var aLevel
array_var aMetDays
array_var aUnmetDays
array_var aMatIn
array_var aWagonRoad
array_var aWagonOk
array_var aStaffNerve
array_var aStaffLoyal
array_var aStaffTrait
array_var aStaffRes
array_var aStaffWhy
array_var aCandNerve
array_var aCandTrait
array_var aCandRes
array_var aConTown
array_var aConGood
array_var aConRoad
array_var aConOrigin
array_var aConPrice
array_var aConStart
array_var aConNext
array_var aConDone
array_var aConMissed
array_var aMemoX
array_var aMemoWho
array_var aDanger
string_var sP2
int iDayRuns
int iDayRoad
int iDayConTG

begin GameMode

	; --- the markets exist before the company: Starter trade, Goodsprings then Primm ---
	if iInit == 0
		set iInit to 1
		let aAnchor := Ar_List 200, 100, 200, 100, 60, 150
		let aUse := Ar_List 4, 2, 4, 1, 1, 1, 10, 4, 2, 2, 1, 1
		let aNormal := Ar_List 34, 18, 4, 30, 15, 0, 14, 4, 20, 2, 1, 10
		let aTrust := Ar_List 35, 20
		let aWh := Ar_List 0, 0, 0, 0, 0, 0
		let aWorkshops := Ar_List 0, 0
		let aSites := Ar_List 0, 0
		let aQueue := Ar_Construct "array"
		let aStrikes := Ar_Construct "array"
		let aHistCash := Ar_Construct "array"
		let aHistSales := Ar_Construct "array"
		let aHistCosts := Ar_Construct "array"
		let aHistEvent := Ar_Construct "array"
		let aHistLoss := Ar_Construct "array"
		; Primm without a sheriff uses more ammo (My Kind of Town not done)
		if GetQuestCompleted nVPrimmDeputyConv == 0
			let aUse[8] := 3
		else
			set iSheriff to 1
		endif
		let aStock := Ar_Copy aNormal
		set iPresent to 1
		set iWagonOk to 1
		set iLastEventDay to -99
		if iSeed == 0
			set iSeed to 1 + GetRandomPercent * 100 + GetRandomPercent
		endif
	endif
	; the post's arrays (games saved before M1 1.6 have iInit 1)
	if iInit == 1
		set iInit to 2
		let aMemoKind := Ar_Construct "array"
		let aMemoDay := Ar_Construct "array"
		let aMemoDue := Ar_Construct "array"
		let aMemoPick := Ar_Construct "array"
		let aPage := Ar_List "", ""
		let aLetter := Ar_List ""
		let aPostText := Ar_Construct "array"
		let aPostTitle := Ar_Construct "array"
	endif
	; the debt ladder's state (games saved before M1 1.7 have iInit 2)
	if iInit == 2
		set iInit to 3
		set iLastRescue to -99
	endif
	; staff, hiring, the contract and standing orders (games saved before M1 1.8 have iInit 3)
	if iInit == 3
		set iInit to 4
		let aStaffName := Ar_Construct "array"
		let aStaffRole := Ar_Construct "array"
		let aStaffSkill := Ar_Construct "array"
		let aStaffHon := Ar_Construct "array"
		let aStaffWage := Ar_Construct "array"
		let aCandName := Ar_Construct "array"
		let aCandRole := Ar_Construct "array"
		let aCandSkill := Ar_Construct "array"
		let aCandHon := Ar_Construct "array"
		let aCandWage := Ar_Construct "array"
		let aCandRumour := Ar_Construct "array"
		let aCandChecked := Ar_Construct "array"
		let aSOKind := Ar_List 0, 0, 0
		let aSOTown := Ar_List 1, 1, 1
		let aSOGood := Ar_List 0, 0, 0
		let aSOValue := Ar_List 0, 0, 0
		set iLastOffer to -99
		; the founding driver and guard, once the M2 staff arrays exist
		set iNeedFounders to 1
	endif
	; the M2 ledger (games saved before M2 have iInit 4): CCUpgradeFn fills these and widens the rest
	if iInit == 4
		set iInit to 5
		let aMkt := Ar_Construct "array"
		let aBaseUse := Ar_Construct "array"
		let aLevel := Ar_List 1, 2, 0, 0
		let aMetDays := Ar_List 0, 0, 0, 0
		let aUnmetDays := Ar_List 0, 0, 0, 0
		let aMatIn := Ar_List 0, 0, 0, 0
		let aWagonRoad := Ar_Construct "array"
		let aWagonOk := Ar_Construct "array"
		let aStaffNerve := Ar_Construct "array"
		let aStaffLoyal := Ar_Construct "array"
		let aStaffTrait := Ar_Construct "array"
		let aStaffRes := Ar_Construct "array"
		let aStaffWhy := Ar_Construct "array"
		let aCandNerve := Ar_Construct "array"
		let aCandTrait := Ar_Construct "array"
		let aCandRes := Ar_Construct "array"
		let aConTown := Ar_Construct "array"
		let aConGood := Ar_Construct "array"
		let aConRoad := Ar_Construct "array"
		let aConOrigin := Ar_Construct "array"
		let aConPrice := Ar_Construct "array"
		let aConStart := Ar_Construct "array"
		let aConNext := Ar_Construct "array"
		let aConDone := Ar_Construct "array"
		let aConMissed := Ar_Construct "array"
		let aMemoX := Ar_Construct "array"
		let aMemoWho := Ar_Construct "array"
		call CCUpgradeFn
	endif
	if iNeedFounders
		set iNeedFounders to 0
		call CCStaffFn 5 0
	endif
	let aDanger := Ar_List 60, 60, 30, 60

	; --- founding: Alice's letter of credit (Company.found) ---
	if iFoundNow == 1 && iFounded == 0
		set iFoundNow to 0
		set iFounded to 1
		set iTier to 1
		; the daily plan starts on: the company works while you are away
		set iAuto to 1
		set iLoan to 3000
		set iCash to 3000
		set iOwner to 500
		set iOwnerPaidIn to 500
		; setup: wagon 400 and two brahmin 300 from owner funds first, the rest from operating cash
		if iOwner >= 700
			set iPay to 700
		else
			set iPay to iOwner
		endif
		set iOwner to iOwner - iPay
		set iCash to iCash - (700 - iPay) - 150 - 150
		set iAssets to 700
		let iLastClock := Floor (GameDaysPassed - 0.25)
	endif

	; --- the day tick ---
	let iClock := Floor (GameDaysPassed - 0.25)
	set iRuns to 0
	while iFounded == 1 && iEnded == 0 && iLastClock < iClock && iRuns < 14
		let iLastClock += 1
		let iRuns += 1
		let iDay += 1
		set iDaySales to 0
		set iDayCosts to 0
		set iDayLoss to 0
		set iDayEvent to 0
		set iBillsPaid to -1
		set iDayOut to 0
		set iDayBack to 0
		set iPrepaid to 0
		set iStageNote to 0
		set iDayCon to 0
		set iDayRuns to 0
		set iDayRoad to 1
		set iDayConTG to 100
		set iDaySigned to 0
		set iSkim to 0
		let iShield := call CCShieldFn
		let iWages := call CCWagesFn

		; settle memos (Company._settle_memos): the answered ones and the ones due today (unanswered:
		; the cautious default). Road: 0 send, 1 hire a gun, 2 keep the wagon home (default).
		; Prepay: 0 pay 300 off the loan, 1 keep the cash (default).
		let iI := (ar_Size aMemoKind) - 1
		while iI >= 0
			if eval (aMemoPick[iI] >= 0 || aMemoDue[iI] <= iDay)
				let iK := aMemoPick[iI]
				if eval (aMemoKind[iI] == 0)
					if iK < 0
						set iK to 2
						let iJ := aMemoDue[iI]
						let iN := call CCContractFn 4 iJ 0
						if iN
							set iK to 0
						endif
					endif
					set iRoadMode to iK
				elseif eval (aMemoKind[iI] == 2)
					; a contract offer: 0 accept, 1 counter at +7%, 2 decline (the default)
					if iK < 0
						set iK to 2
					endif
					call CCContractFn 3 iI iK
				elseif eval (aMemoKind[iI] == 3)
					; a raise: 0 give 25%, 1 refuse (the default)
					if iK < 0
						set iK to 1
					endif
					call CCPeopleFn 2 iI iK
				elseif iK == 0
					set iPay to 300
					if iLoan < iPay
						set iPay to iLoan
					endif
					if iCash < iPay
						set iPay to iCash
					endif
					set iCash to iCash - iPay
					set iLoan to iLoan - iPay
					set iPrepaid to iPay
				endif
				ar_Erase aMemoKind iI
				ar_Erase aMemoDay iI
				ar_Erase aMemoDue iI
				ar_Erase aMemoPick iI
				ar_Erase aMemoX iI
				ar_Erase aMemoWho iI
			endif
			set iI to iI - 1
		loop

		; accept the bookkeeper's plan every day when the player set it (Company.plan, before the trip)
		if iAuto
			set iInTick to 1
			let aQueue := call CCPlanFn
			set iInTick to 0
		endif

		; pay arrears from cash first (Company._pay_arrears)
		if iArrears > 0 && iCash > 0
			if iCash < iArrears
				set iTake to iCash
			else
				set iTake to iArrears
			endif
			set iCash to iCash - iTake
			set iArrears to iArrears - iTake
			if iArrears == 0 && iStage != 1
				if iStage == 6
					; curing a takeover clears the oldest strike
					if eval ((ar_Size aStrikes) > 0)
						ar_Erase aStrikes 0
					endif
				endif
				set iStage to 5
				set iStageDay to iDay
			endif
		endif

		; the trips (Company.tick): every running road, its contract crates, its legs, the director's
		; event on the event road (CCTripFn). A road memo may keep the wagon home or hire a gun for 25.
		set iDayWagon to iWagonOk
		set iDayMode to iRoadMode
		set iRoadMode to 0
		; without a driver the wagon stays in the yard (cover 0)
		let iCover := call CCCoverFn
		set iDayCrew to 0
		if iCover > 0
			set iDayCrew to 1
		endif
		call CCTripFn
		let aQueue := Ar_Construct "array"

		; staff with honesty under 30 skim 2% of the day's sales each (Company._skim)
		set iN to 0
		set iK to 0
		while iK < ar_Size aStaffHon
			if eval (aStaffHon[iK] < 30)
				set iN to iN + 1
			endif
			set iK to iK + 1
		loop
		if iN > 0 && iDaySales > 0
			let iSkim := iN * Floor (0.02 * iDaySales + 0.5)
			if iSkim > iCash
				set iSkim to iCash
			endif
			set iCash to iCash - iSkim
			set iDayCosts to iDayCosts + iSkim
		endif

		; sites and workshops (Company.run_workshops, CCWorkFn 0)
		call CCWorkFn 0

		; running costs accrue daily, paid on bill day; wear is not cash
		set iAccWages to iAccWages + iWages
		set iAccFeed to iAccFeed + 6
		set iAssets to iAssets - 7
		if iAssets < 0
			set iAssets to 0
		endif

		; overnight restock: short stock refills 25% of the gap, a glut drains 12%
		set iK to 0
		while iK < 48
			if eval (aStock[iK] < aNormal[iK])
				let aStock[iK] := aStock[iK] + (aNormal[iK] - aStock[iK]) * 0.25
			else
				let aStock[iK] := aStock[iK] + (aNormal[iK] - aStock[iK]) * 0.12
			endif
			set iK to iK + 1
		loop

		; bills on every 7th day (Company._bills): wages, duty, rent, feed, licence, interest, principal
		if eval (iDay % 7 == 0)
			let aBill := Ar_List 0, 0, 70, 0, 0, 0, 0
			let aBill[0] := iAccWages
			; NCR duty: 2%, 3.5% on the part above 5,000, 5% above 20,000
			let fM := 0.02 * iWeekSales
			if iWeekSales > 5000
				let fM := 0.02 * 5000 + 0.035 * ((iWeekSales < 20000) * iWeekSales + (iWeekSales >= 20000) * 20000 - 5000)
			endif
			if iWeekSales > 20000
				let fM := fM + 0.05 * (iWeekSales - 20000)
			endif
			let aBill[1] := Floor (fM + 0.5)
			let aBill[3] := iAccFeed
			if eval (iDay % 28 == 0)
				let aBill[4] := 150
			endif
			let aBill[5] := Floor (0.04 * iLoan + 0.5)
			if iLoan < 300
				let aBill[6] := iLoan
			else
				let aBill[6] := 300
			endif
			let iBillTotal := aBill[0] + aBill[1] + aBill[2] + aBill[3] + aBill[4] + aBill[5] + aBill[6]
			set iAccWages to 0
			set iAccFeed to 0
			set iWeekSales to 0
			if iCash >= iBillTotal
				set iCash to iCash - iBillTotal
				let iLoan -= aBill[6]
				set iBillsPaid to 1
			else
				set iBillsPaid to 0
				set iPay to 0
				set iK to 0
				while iK < 7
					let iBill := aBill[iK]
					if iCash < iBill
						set iTake to iCash
					else
						set iTake to iBill
					endif
					set iCash to iCash - iTake
					set iPay to iPay + iTake
					if iK == 6
						set iLoan to iLoan - iTake
					endif
					set iK to iK + 1
				loop
				let iArrears += (iBillTotal - iPay) + Floor (0.1 * (iBillTotal - iPay) + 0.5)
				if iStage == 0 || iStage == 5
					set iFromProb to 0
					if iStage == 5
						set iFromProb to 1
					endif
					set iStage to 1
					set iStageDay to iDay
				endif
			endif
		endif

		; the week's loyalty and the bookkeeper (Company._week_people, CCPeopleFn 1)
		if eval (iDay % 7 == 0)
			call CCPeopleFn 1 0 0
		endif

		; this week's candidates on day 1 of each week (Company._new_candidates)
		if eval (iDay % 7 == 1)
			call CCStaffFn 4 0
		endif

		; town levels (Company._levels, CCWorkFn 1)
		call CCWorkFn 1
		; the Powder Gangers took Goodsprings: resident hires leave with the town
		set iGangersTown to GetStageDone VMS16b 100
		if iGangersTown
			let iK := (ar_Size aStaffRes) - 1
			while iK >= 0
				if eval (aStaffRes[iK])
					call CCStaffFn 2 iK
				endif
				set iK to iK - 1
			loop
		endif

		; the debt ladder (Company._ladder): 2 grace, 3 final notice, 4 seized, 5 probation, 6 takeover;
		; the clocks stop while the busy shield is up
		if iStage == 5
			if iDay - iStageDay >= 14
				set iStage to 0
			endif
		elseif iStage >= 2
			if iShield
				set iServedDay to iServedDay + 1
			elseif iStage == 2 && iDay - iServedDay >= 3
				set iStage to 3
				set iArrearsAtFinal to iArrears
				set iStageNote to 1
			elseif iStage == 3 && iDay - iServedDay >= 5
				; keep the wagon by paying down to 40% of the arrears at the final notice
				if eval (iArrears - Floor (0.4 * iArrearsAtFinal) > 0 && iWagonOk)
					set iN to iAssets - iBuildings
					if iN < 0
						set iN to 0
					endif
					let iValue := Floor (0.6 * iN + 0.5)
					set iAssets to iAssets - iN
					set iWagonOk to 0
					set iArrears to iArrears - iValue
					if iArrears < 0
						set iArrears to 0
					endif
					set iStageNote to 2
				endif
				set iStage to 4
				if iArrears == 0
					set iStage to 5
					set iStageDay to iDay
				endif
			elseif (iStage == 4 || iStage == 6) && iDay - iServedDay >= 7 && iArrears > 0
				set iEnded to 1
				set iEndReason to 1
				if iStage == 6
					set iEndReason to 2
				endif
			endif
		endif

		set iGhostTown to GetQuestCompleted VMS16
		if iGhostTown && iGhostPaid == 0
			set iGhostPaid to 1
			let aTrust[0] += 10
			if eval (aTrust[0] > 100)
				let aTrust[0] := 100
			endif
		endif
		; tier 2 gate (Company.tier_two_ready): earned worth 1,500, no strike in 56 days,
		; Goodsprings trust 50, Ghost Town Gunfight done
		set iN to 0
		set iK to 0
		while iK < ar_Size aStrikes
			if eval (iDay - aStrikes[iK] < 56)
				set iN to 1
			endif
			set iK to iK + 1
		loop
		let iValue := iCash + iOwner + iAssets - iLoan - iArrears - iOwnerPaidIn
		set iK to 0
		while iK < 48
			let iValue += aAnchor[iK % 12] * aWh[iK]
			set iK to iK + 1
		loop
		set iTierUp to 0
		if eval (iTier == 1 && iValue >= 1500 && iN == 0 && aTrust[0] >= 50 && iGhostTown)
			set iTier to 2
			set iTierUp to 1
			set iLastEventDay to iDay
			call CCBuildFn 12
		elseif iTier == 2 && iValue >= 18000 && iN == 0
			; tier 3 (Company.tier_three_ready): earned worth 18,000, Liked (50) in two towns, a sheriff in Primm
			let iK := (aTrust[0] >= 50) + (aTrust[1] >= 50) + (aTrust[2] >= 50) + (aTrust[3] >= 50)
			if iK >= 2 && (iSheriff || GetQuestCompleted nVPrimmDeputyConv)
				set iTier to 3
				set iTierUp to 1
				set iLastEventDay to iDay
			endif
		endif

		ar_Append aHistCash iCash
		ar_Append aHistSales iDaySales
		ar_Append aHistCosts iDayCosts
		ar_Append aHistEvent iDayEvent
		ar_Append aHistLoss iDayLoss

		; --- the post (Company._post_memos, _post_letters; texts are tools/post_model.py) ---
		let iBurn := Floor (iWages + 6 + (70 + Floor (0.04 * iLoan + 0.5) + (iLoan < 300) * iLoan + (iLoan >= 300) * 300) / 7 + 0.5)
		if iBurn < 1
			set iBurn to 1
		endif
		let iRun := Floor (iCash / iBurn)
		; tomorrow's forecast: 0 quiet, 1 bandits, 2 no wagon (or no driver)
		if iWagonOk == 0 || iCover == 0
			set iForecast to 2
		else
			let iForecast := call CCFiresFn (iDay + 1), iLastEventDay, iSeed
		endif
		set iRoadPosted to 0
		if eval (iForecast == 1 && (ar_Size aMemoKind) < 3)
			let iEvRoad := call CCRoadsFn 1 (iDay + 1)
			ar_Append aMemoKind 0
			ar_Append aMemoDay iDay
			ar_Append aMemoDue (iDay + 1)
			ar_Append aMemoPick (0 - 1)
			ar_Append aMemoX iEvRoad
			ar_Append aMemoWho " "
			set iRoadPosted to 1
			; the route manager answers it (Company.route_manager_pick): 1 Safe keeps it home, 2 Balanced
			; hires a gun when the clean chance is under 60, 3 Fast sends it; then no letter
			if iRouteMgr
				set iK to 0
				if iRouteMgr == 1
					set iK to 2
				elseif iRouteMgr == 2
					let fM := iCover / aDanger[iEvRoad]
					if eval (Floor (100 * fM * fM / (1 + fM * fM) + 0.5) < 60)
						set iK to 1
					endif
				endif
				let aMemoPick[(ar_Size aMemoPick) - 1] := iK
				set iRoadPosted to 0
			endif
		endif
		set iN to 0
		set iK to 0
		while iK < ar_Size aMemoKind
			if eval (aMemoKind[iK] == 1)
				set iN to 1
			endif
			set iK to iK + 1
		loop
		if eval (iBillsPaid == 1 && iLoan > 0 && iN == 0 && iCash - 300 >= 14 * iBurn && (ar_Size aMemoKind) < 3)
			ar_Append aMemoKind 1
			ar_Append aMemoDay iDay
			ar_Append aMemoDue (iDay + 3)
			ar_Append aMemoPick (0 - 1)
			ar_Append aMemoX 0
			ar_Append aMemoWho " "
		endif
		; a supply contract offer (CCContractFn 2)
		call CCContractFn 2 0 0

		; bills as on the front page (a quiet week): for the forecast letter and page 2
		let iDtb := 7 - iDay % 7
		let iEst := 7 * iWages + 42 + 70 + Floor (0.04 * iLoan + 0.5) + (iLoan < 300) * iLoan + (iLoan >= 300) * 300
		let fM := 0.02 * iWeekSales
		if iWeekSales > 5000
			let fM := 0.02 * 5000 + 0.035 * ((iWeekSales < 20000) * iWeekSales + (iWeekSales >= 20000) * 20000 - 5000)
		endif
		if iWeekSales > 20000
			let fM := fM + 0.05 * (iWeekSales - 20000)
		endif
		let iEst += Floor (fM + 0.5)
		if eval ((iDay + iDtb) % 28 == 0)
			set iEst to iEst + 150
		endif

		; the day's letter texts go to the Post (last 3 kept), most urgent first: closed, notice,
		; forecast, away, road, robbed; the first one waits for the field (Company._post_letters)
		set iNewKind to 0
		if iEnded
			if iEndReason == 2
				let sS := "The lender used the takeover clause and took the office. The company is closed."
			else
				let sS := "It is over, boss. The lender's men changed the locks: the office is a Crimson Caravan branch now. The company is closed."
			endif
			ar_Append aPostText sS
			set iNewKind to 6
			let sNew := sS
			let sS := sv_Construct "LETTER day %.0f  company closed" iDay
			ar_Append aPostTitle sS
		elseif (iStage == 1 && iBillsPaid == 0) || iStageNote > 0
			let sS := call CCNoticeFn 0
			ar_Append aPostText sS
			set iNewKind to 4
			let sNew := sS
			let sS := call CCNoticeFn 2
			ar_Append aPostTitle sS
		endif
		; the forecast: runway under 5 days and no notice open, once for each bill day
		set iShort to 0
		if (iStage == 0 || iStage == 5) && iRun < 5
			set iShort to iEst - iCash
			if iShort < 1
				set iShort to 1
			endif
		endif
		if iShort > 0 && iForecastBill != iDay + iDtb
			set iForecastBill to iDay + iDtb
			let sS := sv_Construct "Boss, cash is thin: at this rate we are short by about %.0f caps on bill day, in %.0f days, unless sales pick up." iShort iDtb
			ar_Append aPostText sS
			if iNewKind == 0
				set iNewKind to 5
				let sNew := sS
			endif
			let sS := sv_Construct "LETTER day %.0f  short on bill day" iDay
			ar_Append aPostTitle sS
		endif
		if iDay - iLastVisit >= 3 && iAwayPosted == 0
			set iAwayPosted to 1
			set iSumS to 0
			set iSumC to 0
			set iK to iLastVisit
			while iK < iDay
				let iSumS += aHistSales[iK]
				let iSumC += aHistCosts[iK]
				set iK to iK + 1
			loop
			set iN to iDay - iLastVisit
			set iJ to iLastVisit + 1
			set iI to ar_Size aMemoKind
			let sS := sv_Construct "Boss, you have been away %.0f days. Since day %.0f: sales %.0f, costs %.0f. Cash %.0f, runway %.0fd. Memos waiting at the office: %.0f." iN iJ iSumS iSumC iCash iRun iI
			ar_Append aPostText sS
			if iNewKind == 0
				set iNewKind to 3
				let sNew := sS
			endif
			let sS := sv_Construct "LETTER day %.0f  while you were away" iDay
			ar_Append aPostTitle sS
		endif
		if iRoadPosted
			let iJ := aDanger[iEvRoad]
			let fM := iCover / iJ
			let iN := Floor (100 * fM * fM / (1 + fM * fM) + 0.5)
			let sP1 := call CCTextFn 1 iEvRoad
			let sP2 := call CCTextFn 2 (iDay + 1)
			let sS := sv_Construct "Bandit sign on the %z tomorrow: about %.0f strong, our cover %.0f: %.0f in 100 to get through clean. Keep the wagon home tomorrow?%z" sP1 iJ iCover iN sP2
			ar_Append aPostText sS
			if iNewKind == 0
				set iNewKind to 2
				let sNew := sS
			endif
			let sS := sv_Construct "LETTER day %.0f  bandit sign" iDay
			ar_Append aPostTitle sS
		endif
		if iDayEvent == 2 || iDayEvent == 3
			let sP1 := call CCTextFn 1 iEvRoad
			if iDayEvent == 3
				let sS := sv_Construct "Bandits took the whole strongbox on the %z: %.0f caps lost. The crew is unhurt." sP1 iDayLoss
			else
				let sS := sv_Construct "Bandits robbed the wagon on the %z: %.0f caps lost. The crew is unhurt." sP1 iDayLoss
			endif
			ar_Append aPostText sS
			if iNewKind == 0
				set iNewKind to 1
				let sNew := sS
			endif
			let sS := sv_Construct "LETTER day %.0f  robbed" iDay
			ar_Append aPostTitle sS
		endif
		if iTierUp
			if iTier == 3
				let sS := "Boss, we are a caravan company now. Sloan and the Outpost gave us branches, the route manager can be hired, and the smokehouse and stone yard are on the Build screen."
			else
				let sS := "Boss, we are an Outfit now. Our office next to the Prospector Saloon is open and Primm gave us a stall. The Build screen is open at the terminal: purifier, apothecary, well rig, forager hut."
			endif
			ar_Append aPostText sS
			if iNewKind == 0
				set iNewKind to 7
				let sNew := sS
			endif
			if iTier == 3
				let sS := sv_Construct "LETTER day %.0f  a caravan company" iDay
			else
				let sS := sv_Construct "LETTER day %.0f  an Outfit now" iDay
			endif
			ar_Append aPostTitle sS
		endif
		while (ar_Size aPostText) > 3
			ar_Erase aPostText 0
			ar_Erase aPostTitle 0
		loop
		; a deferred notice waits above everything but a closed company, rewritten every day; a waiting
		; while-you-were-away letter stays unless something more urgent came
		if iStage == 1 && iNewKind != 4 && iNewKind != 6
			set iNewKind to 4
			let sNew := call CCNoticeFn 0
		endif
		if iLetterKind == 3 && (iNewKind == 0 || iNewKind == 1 || iNewKind == 2 || iNewKind == 7)
			set iLetterKind to 3
		elseif iLetterKind == 7 && iNewKind == 0
			set iLetterKind to 7
		else
			set iLetterKind to iNewKind
			if iNewKind
				let aLetter[0] := sNew
			endif
		endif

		; the morning report (CCReportFn)
		call CCReportFn
	loop
end
