scn CCCoreScript

; Mojave Caravan Company: the ledger and the day tick (M1 plan task 1.3).
; tools/company_model.py is the spec: same formulas, same order, whole caps rounded half up, the
; same seeded rolls. Towns: 0 Goodsprings, 1 Primm. Goods: 0 purified water, 1 healing powder,
; 2 ammo, 3 dirty water, 4 herbs, 5 building materials. Town-good cells are index town*6 + good.
; The company day ticks at 06:00 game time; missed days run in order, at most 14 per script run.
; Variables are only ever appended (saves keep them by index); one GameMode block, no early return.
; The post (plan task 1.6, texts in tools/post_model.py): memos (aMemo*: kind 0 road, 1 prepay; pick
; -1 unanswered), tomorrow's forecast, the report's two pages (aPage), the last 3 letter texts (aPost*) and
; the one letter waiting to be shown in the field (iLetterKind 1 robbed, 2 road, 3 away; aLetter[0]).

int iInit
int iFounded
int iEnded
int iSeed
int iDay
int iLastClock
int iClock
int iTier
int iCash
int iOwner
int iOwnerPaidIn
int iLoan
int iAssets
int iSheriff
int iPresent
int iShield
int iAuto
int iFoundNow
int iWeekSales
int iAccWages
int iAccFeed
int iArrears
int iStage
int iServedDay
int iStageDay
int iArrearsAtFinal
int iLastEventDay
int iWagonOk
int iGhostTown
int iHands
int iDaySales
int iDayCosts
int iDayLoss
int iDayEvent
int iBillsPaid
int iBillTotal
int iRuns
int iT
int iG
int iK
int iN
int iI
int iLeg
int iOrigin
int iDest
int iBest
int iBestG
int iBestOwn
int iBestCost
int iCost
int iSale
int iOwn
int iLost
int iCap
int iValue
int iWreck
int iChance
int iBurn
int iPay
int iTake
int iCode
int iPlanCash
int iBill
float fM
array_var aStock
array_var aUse
array_var aNormal
array_var aAnchor
array_var aTrust
array_var aWh
array_var aQueue
array_var aLeg
array_var aLegCost
array_var aSo
array_var aSd
array_var aWhPlan
array_var aStrikes
array_var aWorkshops
array_var aSites
array_var aHistCash
array_var aHistSales
array_var aHistCosts
array_var aHistEvent
array_var aHistLoss
array_var aBill
array_var aKeep
int iRoadMode
int iForecast
int iLastVisit
int iAwayPosted
int iLetterKind
int iLetterShownDay
int iPrepaid
int iDayOut
int iDayBack
int iDayMode
int iDayWagon
int iFires
int iClean
int iRoadPosted
int iNewKind
int iDtb
int iEst
int iRun
int iJ
int iSumS
int iSumC
array_var aMemoKind
array_var aMemoDay
array_var aMemoDue
array_var aMemoPick
array_var aPage
array_var aLetter
array_var aPostText
array_var aPostTitle
string_var sS
string_var sP1
string_var sNew

begin GameMode

	; --- the markets exist before the company: Starter trade, Goodsprings then Primm ---
	if iInit == 0
		set iInit to 1
		let aAnchor := Ar_List 200, 100, 200, 100, 60, 150
		let aUse := Ar_List 4, 2, 4, 1, 1, 1, 10, 4, 2, 2, 1, 1
		let aNormal := Ar_List 34, 18, 4, 30, 15, 0, 14, 4, 20, 2, 1, 10
		let aTrust := Ar_List 35, 20
		let aWh := Ar_List 0, 0, 0, 0, 0, 0
		let aWorkshops := Ar_List 0, 0
		let aSites := Ar_List 0, 0
		let aQueue := Ar_Construct "array"
		let aStrikes := Ar_Construct "array"
		let aHistCash := Ar_Construct "array"
		let aHistSales := Ar_Construct "array"
		let aHistCosts := Ar_Construct "array"
		let aHistEvent := Ar_Construct "array"
		let aHistLoss := Ar_Construct "array"
		; Primm without a sheriff uses more ammo (My Kind of Town not done)
		if GetQuestCompleted nVPrimmDeputyConv == 0
			let aUse[8] := 3
		else
			set iSheriff to 1
		endif
		let aStock := Ar_Copy aNormal
		set iPresent to 1
		set iWagonOk to 1
		set iLastEventDay to -99
		if iSeed == 0
			set iSeed to 1 + GetRandomPercent * 100 + GetRandomPercent
		endif
	endif
	; the post's arrays (games saved before M1 1.6 have iInit 1)
	if iInit == 1
		set iInit to 2
		let aMemoKind := Ar_Construct "array"
		let aMemoDay := Ar_Construct "array"
		let aMemoDue := Ar_Construct "array"
		let aMemoPick := Ar_Construct "array"
		let aPage := Ar_List "", ""
		let aLetter := Ar_List ""
		let aPostText := Ar_Construct "array"
		let aPostTitle := Ar_Construct "array"
	endif

	; --- founding: Alice's letter of credit (Company.found) ---
	if iFoundNow == 1 && iFounded == 0
		set iFoundNow to 0
		set iFounded to 1
		set iTier to 1
		set iLoan to 3000
		set iCash to 3000
		set iOwner to 500
		set iOwnerPaidIn to 500
		; setup: wagon 400 and two brahmin 300 from owner funds first, the rest from operating cash
		if iOwner >= 700
			set iPay to 700
		else
			set iPay to iOwner
		endif
		set iOwner to iOwner - iPay
		set iCash to iCash - (700 - iPay) - 150 - 150
		set iAssets to 700
		let iLastClock := Floor (GameDaysPassed - 0.25)
	endif

	; --- the day tick ---
	let iClock := Floor (GameDaysPassed - 0.25)
	set iRuns to 0
	while iFounded == 1 && iEnded == 0 && iLastClock < iClock && iRuns < 14
		let iLastClock += 1
		let iRuns += 1
		let iDay += 1
		set iDaySales to 0
		set iDayCosts to 0
		set iDayLoss to 0
		set iDayEvent to 0
		set iBillsPaid to -1
		set iDayOut to 0
		set iDayBack to 0
		set iPrepaid to 0

		; settle memos (Company._settle_memos): the answered ones and the ones due today (unanswered:
		; the cautious default). Road: 0 send, 1 hire a gun, 2 keep the wagon home (default).
		; Prepay: 0 pay 300 off the loan, 1 keep the cash (default).
		let iI := (ar_Size aMemoKind) - 1
		while iI >= 0
			if eval (aMemoPick[iI] >= 0 || aMemoDue[iI] <= iDay)
				let iK := aMemoPick[iI]
				if eval (aMemoKind[iI] == 0)
					if iK < 0
						set iK to 2
					endif
					set iRoadMode to iK
				elseif iK == 0
					set iPay to 300
					if iLoan < iPay
						set iPay to iLoan
					endif
					if iCash < iPay
						set iPay to iCash
					endif
					set iCash to iCash - iPay
					set iLoan to iLoan - iPay
					set iPrepaid to iPay
				endif
				ar_Erase aMemoKind iI
				ar_Erase aMemoDay iI
				ar_Erase aMemoDue iI
				ar_Erase aMemoPick iI
			endif
			set iI to iI - 1
		loop

		; accept the bookkeeper's plan every day when the player set it (Company.plan, before the trip)
		if iAuto
			let aQueue := call CCPlanFn
		endif

		; pay arrears from cash first (Company._pay_arrears)
		if iArrears > 0 && iCash > 0
			if iCash < iArrears
				set iTake to iCash
			else
				set iTake to iArrears
			endif
			set iCash to iCash - iTake
			set iArrears to iArrears - iTake
			if iArrears == 0
				set iStage to 5
				set iStageDay to iDay
			endif
		endif

		; the trip (Company.tick): out leg Goodsprings -> Primm, back leg Primm -> Goodsprings. A road memo
		; may keep the wagon home (the bandits wait for nothing) or hire a gun for 25 caps.
		set iDayWagon to iWagonOk
		set iDayMode to iRoadMode
		set iRoadMode to 0
		let iFires := call CCFiresFn iDay, iLastEventDay, iSeed
		if iWagonOk && iDayMode == 2
			if iFires
				set iLastEventDay to iDay
			endif
		elseif iWagonOk
			if iDayMode == 1
				set iPay to 25
				if iCash < iPay
					set iPay to iCash
				endif
				set iCash to iCash - iPay
				set iDayCosts to iDayCosts + iPay
			endif
			set iLeg to 0
			while iLeg < 2
				set iOrigin to iLeg
				set iDest to 1 - iLeg
				; before the return leg the director may send bandits (Company._event): they rob the
				; strongbox, the day's Primm takings: 30% of it, all of it in a wreck, at most 3 days of costs
				if iLeg == 1 && iFires
					set iLastEventDay to iDay
					; P(clean) = r^2 / (1 + r^2), r = cover / danger 60: 36 in 100 at cover 45, 61 at 75
					if iDayMode == 1
						set iClean to 61
					else
						set iClean to 36
					endif
					if eval ((iDay * 7919 + iSeed * 104729 + 62) % 100 < iClean)
						set iDayEvent to 1
					elseif iDaySales <= 0
						set iDayEvent to 4
					else
						let iWreck := (iDay * 7919 + iSeed * 104729 + 93) % 100 < 33
						if iWreck
							set iValue to iDaySales
							set iDayEvent to 3
						else
							let iValue := Floor (0.3 * iDaySales + 0.5)
							set iDayEvent to 2
						endif
						let iBurn := Floor (22 + 14 * iHands + 6 + (70 + Floor (0.04 * iLoan + 0.5) + (iLoan < 300) * iLoan + (iLoan >= 300) * 300) / 7 + 0.5)
						if iValue > 3 * iBurn
							set iValue to 3 * iBurn
						endif
						set iCash to iCash - iValue
						set iDayCosts to iDayCosts + iValue
						set iDayLoss to iValue
					endif
				endif
				let aLeg := Ar_Construct "array"
				set iI to 0
				while iI < ar_Size aQueue
					let iCode := aQueue[iI]
					if eval (Floor (iCode / 10) == iOrigin)
						let iG := iCode % 10
						if eval (iOrigin == 0 && aWh[iG] > 0)
							let aWh[iG] -= 1
							ar_Append aLeg iG
						else
							let iCost := call CCPriceFn aAnchor[iG], aStock[iOrigin * 6 + iG], aUse[iOrigin * 6 + iG], aTrust[iOrigin], 0
							if iCost <= iCash
								set iCash to iCash - iCost
								set iDayCosts to iDayCosts + iCost
								let aStock[iOrigin * 6 + iG] -= 1
								ar_Append aLeg iG
							endif
						endif
					endif
					set iI to iI + 1
				loop
				set iI to 0
				while iI < ar_Size aLeg
					let iG := aLeg[iI]
					let iSale := call CCPriceFn aAnchor[iG], aStock[iDest * 6 + iG], aUse[iDest * 6 + iG], aTrust[iDest], 1
					set iCash to iCash + iSale
					set iDaySales to iDaySales + iSale
					set iWeekSales to iWeekSales + iSale
					let aStock[iDest * 6 + iG] += 1
					if iOrigin == 0
						set iDayOut to iDayOut + 1
					else
						set iDayBack to iDayBack + 1
					endif
					set iI to iI + 1
				loop
				set iLeg to iLeg + 1
			loop
		endif
		let aQueue := Ar_Construct "array"

		; workshops (Company.run_workshops): raw sites, then purifier 5 dirty -> 4 water, apothecary 1 -> 1
		if eval (aSites[0])
			let aWh[3] += 4
		endif
		if eval (aSites[1])
			let aWh[4] += 4
		endif
		if eval (aWorkshops[0])
			set iN to 0
			while aWh[3] >= 5 && iN + 4 <= 4
				let aWh[3] -= 5
				let aWh[0] += 4
				set iN to iN + 4
			loop
		endif
		if eval (aWorkshops[1])
			set iN to 0
			while aWh[4] >= 1 && iN + 1 <= 4
				let aWh[4] -= 1
				let aWh[1] += 1
				set iN to iN + 1
			loop
		endif

		; running costs accrue daily, paid on bill day; wear is not cash
		set iAccWages to iAccWages + 22 + 14 * iHands
		set iAccFeed to iAccFeed + 6
		set iAssets to iAssets - 7
		if iAssets < 0
			set iAssets to 0
		endif

		; overnight restock: short stock refills 25% of the gap, a glut drains 12%
		set iK to 0
		while iK < 12
			if eval (aStock[iK] < aNormal[iK])
				let aStock[iK] := aStock[iK] + (aNormal[iK] - aStock[iK]) * 0.25
			else
				let aStock[iK] := aStock[iK] + (aNormal[iK] - aStock[iK]) * 0.12
			endif
			set iK to iK + 1
		loop

		; bills on every 7th day (Company._bills): wages, duty, rent, feed, licence, interest, principal
		if eval (iDay % 7 == 0)
			let aBill := Ar_List 0, 0, 70, 0, 0, 0, 0
			let aBill[0] := iAccWages
			; NCR duty: 2%, 3.5% on the part above 5,000, 5% above 20,000
			let fM := 0.02 * iWeekSales
			if iWeekSales > 5000
				let fM := 0.02 * 5000 + 0.035 * ((iWeekSales < 20000) * iWeekSales + (iWeekSales >= 20000) * 20000 - 5000)
			endif
			if iWeekSales > 20000
				let fM := fM + 0.05 * (iWeekSales - 20000)
			endif
			let aBill[1] := Floor (fM + 0.5)
			let aBill[3] := iAccFeed
			if eval (iDay % 28 == 0)
				let aBill[4] := 150
			endif
			let aBill[5] := Floor (0.04 * iLoan + 0.5)
			if iLoan < 300
				let aBill[6] := iLoan
			else
				let aBill[6] := 300
			endif
			let iBillTotal := aBill[0] + aBill[1] + aBill[2] + aBill[3] + aBill[4] + aBill[5] + aBill[6]
			set iAccWages to 0
			set iAccFeed to 0
			set iWeekSales to 0
			if iCash >= iBillTotal
				set iCash to iCash - iBillTotal
				let iLoan -= aBill[6]
				set iBillsPaid to 1
			else
				set iBillsPaid to 0
				set iPay to 0
				set iK to 0
				while iK < 7
					let iBill := aBill[iK]
					if iCash < iBill
						set iTake to iCash
					else
						set iTake to iBill
					endif
					set iCash to iCash - iTake
					set iPay to iPay + iTake
					if iK == 6
						set iLoan to iLoan - iTake
					endif
					set iK to iK + 1
				loop
				let iArrears += (iBillTotal - iPay) + Floor (0.1 * (iBillTotal - iPay) + 0.5)
				if iStage == 0 || iStage == 5
					set iStage to 1
					set iStageDay to iDay
					if iPresent && iShield == 0
						set iStage to 2
						set iServedDay to iDay
						let aKeep := Ar_Construct "array"
						set iK to 0
						while iK < ar_Size aStrikes
							if eval (iDay - aStrikes[iK] < 56)
								ar_Append aKeep aStrikes[iK]
							endif
							set iK to iK + 1
						loop
						ar_Append aKeep iDay
						let aStrikes := aKeep
					endif
				endif
			endif
		endif

		; the debt ladder (Company._ladder): 2 grace, 3 final notice, 4 seized, 5 probation
		if iStage == 5
			if iDay - iStageDay >= 14
				set iStage to 0
			endif
		elseif iStage >= 2
			if iShield
				set iServedDay to iServedDay + 1
			elseif iStage == 2 && iDay - iServedDay >= 3
				set iStage to 3
				set iArrearsAtFinal to iArrears
			elseif iStage == 3 && iDay - iServedDay >= 5
				if iArrears > 0.4 * iArrearsAtFinal
					let iValue := Floor (0.6 * iAssets + 0.5)
					set iAssets to 0
					set iWagonOk to 0
					set iArrears to iArrears - iValue
					if iArrears < 0
						set iArrears to 0
					endif
				endif
				set iStage to 4
				if iArrears == 0
					set iStage to 5
					set iStageDay to iDay
				endif
			elseif iStage == 4 && iDay - iServedDay >= 7 && iArrears > 0
				set iEnded to 1
			endif
		endif

		set iGhostTown to GetQuestCompleted VMS16
		; tier 2 gate (Company.tier_two_ready): earned worth 1,500, no strike in 56 days,
		; Goodsprings trust 50, Ghost Town Gunfight done
		set iN to 0
		set iK to 0
		while iK < ar_Size aStrikes
			if eval (iDay - aStrikes[iK] < 56)
				set iN to 1
			endif
			set iK to iK + 1
		loop
		let iValue := iCash + iOwner + 200 * aWh[0] + 100 * aWh[1] + 200 * aWh[2] + 100 * aWh[3] + 60 * aWh[4] + 150 * aWh[5] + iAssets - iLoan - iArrears - iOwnerPaidIn
		if eval (iTier == 1 && iValue >= 1500 && iN == 0 && aTrust[0] >= 50 && iGhostTown)
			set iTier to 2
		endif

		ar_Append aHistCash iCash
		ar_Append aHistSales iDaySales
		ar_Append aHistCosts iDayCosts
		ar_Append aHistEvent iDayEvent
		ar_Append aHistLoss iDayLoss

		; --- the post (Company._post_memos, _post_letters; texts are tools/post_model.py) ---
		let iBurn := Floor (22 + 14 * iHands + 6 + (70 + Floor (0.04 * iLoan + 0.5) + (iLoan < 300) * iLoan + (iLoan >= 300) * 300) / 7 + 0.5)
		if iBurn < 1
			set iBurn to 1
		endif
		let iRun := Floor (iCash / iBurn)
		; tomorrow's forecast: 0 quiet, 1 bandits, 2 no wagon
		if iWagonOk == 0
			set iForecast to 2
		else
			let iForecast := call CCFiresFn (iDay + 1), iLastEventDay, iSeed
		endif
		set iRoadPosted to 0
		if eval (iForecast == 1 && (ar_Size aMemoKind) < 3)
			ar_Append aMemoKind 0
			ar_Append aMemoDay iDay
			ar_Append aMemoDue (iDay + 1)
			ar_Append aMemoPick (0 - 1)
			set iRoadPosted to 1
		endif
		set iN to 0
		set iK to 0
		while iK < ar_Size aMemoKind
			if eval (aMemoKind[iK] == 1)
				set iN to 1
			endif
			set iK to iK + 1
		loop
		if eval (iBillsPaid == 1 && iLoan > 0 && iN == 0 && iCash - 300 >= 14 * iBurn && (ar_Size aMemoKind) < 3)
			ar_Append aMemoKind 1
			ar_Append aMemoDay iDay
			ar_Append aMemoDue (iDay + 3)
			ar_Append aMemoPick (0 - 1)
		endif

		; the day's letter texts go to the Post (last 3 kept); the first waits for the field, unless a
		; while-you-were-away letter is still waiting
		set iNewKind to 0
		if iDay - iLastVisit >= 3 && iAwayPosted == 0
			set iAwayPosted to 1
			set iSumS to 0
			set iSumC to 0
			set iK to iLastVisit
			while iK < iDay
				let iSumS += aHistSales[iK]
				let iSumC += aHistCosts[iK]
				set iK to iK + 1
			loop
			set iN to iDay - iLastVisit
			set iJ to iLastVisit + 1
			set iI to ar_Size aMemoKind
			let sS := sv_Construct "Boss, you have been away %.0f days. Since day %.0f: sales %.0f, costs %.0f. Cash %.0f, runway %.0fd. Memos waiting at the office: %.0f." iN iJ iSumS iSumC iCash iRun iI
			ar_Append aPostText sS
			set iNewKind to 3
			let sNew := sS
			let sS := sv_Construct "LETTER day %.0f  while you were away" iDay
			ar_Append aPostTitle sS
		endif
		if iRoadPosted
			let sS := "Bandit sign on the Primm road tomorrow: about 60 strong, our cover is 45. Keep the wagon home tomorrow?"
			ar_Append aPostText sS
			if iNewKind == 0
				set iNewKind to 2
				let sNew := sS
			endif
			let sS := sv_Construct "LETTER day %.0f  bandit sign" iDay
			ar_Append aPostTitle sS
		endif
		if iDayEvent == 2 || iDayEvent == 3
			if iDayEvent == 3
				let sS := sv_Construct "Bandits took the whole strongbox on the Primm road: %.0f caps lost. The crew is unhurt." iDayLoss
			else
				let sS := sv_Construct "Bandits robbed the wagon on the Primm road: %.0f caps lost. The crew is unhurt." iDayLoss
			endif
			ar_Append aPostText sS
			if iNewKind == 0
				set iNewKind to 1
				let sNew := sS
			endif
			let sS := sv_Construct "LETTER day %.0f  robbed" iDay
			ar_Append aPostTitle sS
		endif
		while (ar_Size aPostText) > 3
			ar_Erase aPostText 0
			ar_Erase aPostTitle 0
		loop
		if iLetterKind != 3
			set iLetterKind to iNewKind
			if iNewKind
				let aLetter[0] := sNew
			endif
		endif

		; the morning report, page 1: the bookkeeper's letter
		if iDayWagon == 0
			let sP1 := "Boss. The wagon is in the lender's yard, so nothing moved."
		elseif iDayMode == 2
			let sP1 := "Boss. The wagon stayed home today, as the memo said: bandit sign on the Primm road."
		elseif iDayOut + iDayBack == 0
			let sP1 := "Boss. The wagon went to Primm and back with no cargo: nothing paid the trip."
		else
			let sP1 := sv_Construct "Boss. The wagon took %.0f crates to Primm and brought %.0f back." iDayOut iDayBack
		endif
		if iDayMode == 1
			let sP1 := sP1 + " We hired a gun for the road."
		endif
		if iDayEvent == 1
			let sP1 := sP1 + " Bandits tried the Primm road and our guard drove them off."
		elseif iDayEvent == 2
			let sS := sv_Construct " Bandits robbed the wagon on the way back: %.0f caps lost." iDayLoss
			let sP1 := sP1 + sS
		elseif iDayEvent == 3
			let sS := sv_Construct " Bandits took the whole strongbox on the way back: %.0f caps lost." iDayLoss
			let sP1 := sP1 + sS
		elseif iDayEvent == 4
			let sP1 := sP1 + " Bandits stopped the wagon on the way back and found nothing to take."
		endif
		if iBillsPaid == 1
			let sS := sv_Construct " The week's bills, %.0f, are paid." iBillTotal
			let sP1 := sP1 + sS
		elseif iBillsPaid == 0
			let sS := sv_Construct " We could not pay all the bills: %.0f is owed." iArrears
			let sP1 := sP1 + sS
		endif
		if iPrepaid > 0
			let sS := sv_Construct " We paid %.0f off the loan." iPrepaid
			let sP1 := sP1 + sS
		endif
		let aPage[0] := sP1

		; page 2: the numbers and tomorrow's forecast; bills as on the front page (a quiet week)
		let iDtb := 7 - iDay % 7
		let iEst := 7 * (22 + 14 * iHands) + 42 + 70 + Floor (0.04 * iLoan + 0.5) + (iLoan < 300) * iLoan + (iLoan >= 300) * 300
		let fM := 0.02 * iWeekSales
		if iWeekSales > 5000
			let fM := 0.02 * 5000 + 0.035 * ((iWeekSales < 20000) * iWeekSales + (iWeekSales >= 20000) * 20000 - 5000)
		endif
		if iWeekSales > 20000
			let fM := fM + 0.05 * (iWeekSales - 20000)
		endif
		let iEst += Floor (fM + 0.5)
		if eval ((iDay + iDtb) % 28 == 0)
			set iEst to iEst + 150
		endif
		set iN to iDaySales - iDayCosts
		if iForecast == 1
			let sS := sv_Construct "Day %.0f: sales %.0f, costs %.0f, net %.0f. Cash %.0f, runway %.0fd. Bills in %.0fd, about %.0f. Tomorrow: bandit sign on the Primm road, about 60 strong, our cover 45." iDay iDaySales iDayCosts iN iCash iRun iDtb iEst
		elseif iForecast == 0
			let sS := sv_Construct "Day %.0f: sales %.0f, costs %.0f, net %.0f. Cash %.0f, runway %.0fd. Bills in %.0fd, about %.0f. Tomorrow: the road looks quiet." iDay iDaySales iDayCosts iN iCash iRun iDtb iEst
		else
			let sS := sv_Construct "Day %.0f: sales %.0f, costs %.0f, net %.0f. Cash %.0f, runway %.0fd. Bills in %.0fd, about %.0f. Tomorrow: no wagon on the road." iDay iDaySales iDayCosts iN iCash iRun iDtb iEst
		endif
		let aPage[1] := sS
	loop
end
