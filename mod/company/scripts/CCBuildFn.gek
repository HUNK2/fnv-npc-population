scn CCBuildFn

; Tier 2 buildings (tools/company_model.py Company.can_build, build; tools/terminal_model.py
; chains_row, build_rows). Works on CCCore's variables by name.
; iAct 0: draw the Build screen's rows 0 to 4 (money, then purifier, apothecary, well rig, forager
;         hut: the cost, or BUILT); returns 5, the row BACK goes in.
; iAct 1 to 4: build that one: from tier 2, once, paid from owner money first, then cash; a raw site
;         comes with a hand. Returns 1 if built.
; iAct 5: draw the front page's CHAINS row (row 6).
; iAct 6: tier 2 in the world: the office by the Prospector Saloon and the Primm stall appear.

int iAct
int iOut
int iTier
int iCash
int iOwner
int iCost
int iBuilt
int iK
int iN
int iFrom
array_var aW
array_var aS
string_var sS

begin Function {iAct}
	set iOut to 0
	let iTier := GetVariable "iTier" CCCore
	let iCash := GetVariable "iCash" CCCore
	let iOwner := GetVariable "iOwner" CCCore
	let aW := GetArrayVariable "aWorkshops" CCCore
	let aS := GetArrayVariable "aSites" CCCore

	if iAct == 5
		if iTier < 2
			Console "SetTerminalMenuItemText CCOfficeTerm 1 6 %qCHAINS   none yet (tier 2)%q"
		else
			let iN := aW[0] + aW[1] + aS[0] + aS[1]
			Console "SetTerminalMenuItemText CCOfficeTerm 1 6 %qCHAINS   %.0f of 4 built%q" iN
		endif

	elseif iAct == 6
		CCOfficeShackRef.Enable
		CCOfficeDoorRef.Enable
		CCPrimmStallCartRef.Enable
		CCPrimmStallCrate1Ref.Enable
		CCPrimmStallCrate2Ref.Enable
		CCPrimmStallBoardRef.Enable
		set iOut to 1

	elseif iAct == 0
		Console "SetTerminalMenuItemText CCOfficeTerm 1 0 %qMONEY  cash %.0f, own money %.0f%q" iCash iOwner
		set iK to 1
		while iK <= 4
			if iK <= 2
				let iBuilt := aW[iK - 1]
				set iCost to 300
			else
				let iBuilt := aS[iK - 3]
				set iCost to 200
			endif
			if iBuilt
				let sS := "BUILT"
			else
				let sS := sv_Construct "%.0f" iCost
			endif
			if iK == 1
				Console "SetTerminalMenuItemText CCOfficeTerm 1 1 %qPURIFIER   5 dirty > 4 water   %z%q" sS
			elseif iK == 2
				Console "SetTerminalMenuItemText CCOfficeTerm 1 2 %qAPOTHECARY 1 herbs > 1 powder  %z%q" sS
			elseif iK == 3
				Console "SetTerminalMenuItemText CCOfficeTerm 1 3 %qWELL RIG   4 dirty water a day %z%q" sS
			else
				Console "SetTerminalMenuItemText CCOfficeTerm 1 4 %qFORAGER    4 herbs a day       %z%q" sS
			endif
			set iK to iK + 1
		loop
		set iOut to 5

	elseif iAct >= 1 && iAct <= 4 && iTier >= 2 && (GetVariable "iEnded" CCCore) == 0
		if iAct <= 2
			let iBuilt := aW[iAct - 1]
			set iCost to 300
		else
			let iBuilt := aS[iAct - 3]
			set iCost to 200
		endif
		if iBuilt == 0 && iCash + iOwner >= iCost
			set iFrom to iOwner
			if iFrom > iCost
				set iFrom to iCost
			endif
			set iOwner to iOwner - iFrom
			set iCash to iCash - (iCost - iFrom)
			if iAct <= 2
				let aW[iAct - 1] := 1
			else
				let aS[iAct - 3] := 1
				let iN := (GetVariable "iHands" CCCore) + 1
				SetVariable "iHands" iN CCCore
			endif
			SetVariable "iCash" iCash CCCore
			SetVariable "iOwner" iOwner CCCore
			let iN := (GetVariable "iAssets" CCCore) + iCost
			SetVariable "iAssets" iN CCCore
			let iN := (GetVariable "iBuildings" CCCore) + iCost
			SetVariable "iBuildings" iN CCCore
			set iOut to 1
		endif
	endif
	SetFunctionValue iOut
end
