scn CCProofsQuestScript

; M0 proofs: the day tick with catch-up and seeded rolls (design: How it is built in FNV, The day tick).
; Days only move forward; at most 14 missed days run one by one, anything older folds into one summary step.
; One day is processed per script run (no while/loop: the fnv-mcp in-game compile breaks jumps after a loop),
; which also spreads a long catch-up over several frames.
; Note: GameDaysPassed cannot be set from the console; tests jump GameHour (Calendar::Update 0x00867A40 resyncs).

int iInit
int iLastDay
int iToday
int iMissed
int iSteps
int iSummaries
int iSeed
int iRoll
int iRollSum
int iDay	; unused now; kept so variable indices stay stable
int iTicks

begin GameMode
	set iTicks to iTicks + 1
	set iToday to GameDaysPassed
	if iInit == 0
		set iInit to 1
		set iLastDay to iToday
		set iSeed to 1234
		return
	endif
	if iToday <= iLastDay
		return
	endif
	set iMissed to iToday - iLastDay
	if iMissed > 14
		set iSummaries to iSummaries + 1
		set iLastDay to iToday - 14
	endif
	set iLastDay to iLastDay + 1
	set iRoll to (iLastDay * 7919 + iSeed * 104729) % 100
	set iRollSum to iRollSum + iRoll
	set iSteps to iSteps + 1
end

; --- 0.5 and 0.7 script side (variables added at the end so the indices above stay put) ---
; Route C: the engine's click handler sets flag 4 on the clicked row (ComputersMenu::DoClick
; 0x00757F70). While the terminal is open, poll the rows we act on, clear the flag, relabel.
int iPicked
int iClicks
float fPrice

begin MenuMode 1057
	if GetTerminalMenuItemFlags CCProofsTerm 29 != 0
		SetTerminalMenuItemFlags CCProofsTerm 29 0
		set iPicked to 30
		set iClicks to iClicks + 1
		set fPrice to 152 + iClicks * 3
		; runtime-compiled scripts cannot pass a string_var to a plugin command, so the line is built with
		; JIP Console (format string; %q is a quote mark)
		Console "SetTerminalMenuItemText CCProofsTerm 1 0 %qWATER  GS %.0f > PR 236   clicks %.0f%q" fPrice iClicks
		RefreshTerminalMenu
	endif
end
